---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Floor from "../components/Floor.astro";
import Includes from "../components/Includes.astro";
import Calculator from "../components/Calculator.astro";
import Quiz from "../components/Quiz.astro";
import Feasibility from "../components/Feasibility.astro";
import Faq from "../components/Faq.astro";
import Timeline from "../components/Timeline.astro";
import Contact from "../components/Contact.astro";
import Footer from "../components/Footer.astro";
import LeadModal from "../components/LeadModal.astro";
---
<Base>
  <Header />
  <main>
    <Hero />
    <Floor />
    <Includes />
    <Calculator />
    <Quiz />
    <Feasibility />
    <Faq />
    <Timeline />
    <Contact />
  </main>
  <Footer />
  <LeadModal />
  <script>
    import { openLead } from "../lib/leadModal";
    import { captureTouch } from "../lib/lead";
    captureTouch();   // метки визита и первое касание – для заявки (lib/lead.ts)
    // «Get in touch» (первый экран и шапка): общее окно заявки
    document.querySelectorAll<HTMLElement>("[data-open-lead]").forEach((b) => b.addEventListener("click", () => openLead({
      form: b.dataset.loc || "get_in_touch", title: "Let’s discuss your project", lead: "We reply within 1 working hour",
      text: (who) => `Franchise request (${b.dataset.loc}). ${who}`,
    })));
    // кнопки шапки скрыты, пока виден первый экран
    const hero = document.querySelector(".hero");
    if (hero) new IntersectionObserver(([e]) => document.documentElement.classList.toggle("hero-on", e.isIntersecting), { rootMargin: "-80px 0px 0px 0px" }).observe(hero);
    // появление блоков при прокрутке (.rv)
    const rvo = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("in"); rvo.unobserve(e.target); } }),
                                         { threshold: .15, rootMargin: "0px 0px -8% 0px" });
    document.querySelectorAll(".rv").forEach((el) => rvo.observe(el));
    // события для GA4 и Метрики через GTM GTM-TJVPKFZ (сверено с опубликованной версией 61, 23.11.2026):
    // отправка формы – callback_form_sent + form_location: "partner" (триггер «only partner» → GA4 franchise_callback_form_sent и Метрика),
    // какая именно форма – в lead_form. Клик по мессенджеру остаётся franchise_messenger_clicked: событие messenger_clicked на поддомене
    // (путь «/») поймал бы B2C-триггер «except franchise» и записал клик как B2C chat_lead; нужен триггер в GTM (франшизные события лендинга без тегов – список в hub/03-audit/gtm-franchise-landing.md)
    document.addEventListener("click", (e) => {
      const el = (e.target as HTMLElement).closest<HTMLElement>("[data-ev]");
      if (!el) return;
      (window as any).dataLayer?.push({ event: el.dataset.ev, messenger_name: el.dataset.messenger, messenger_link: (el as HTMLAnchorElement).href, event_location: el.dataset.loc,
                                        site_variant: location.pathname });
    });
  </script>
</Base>
