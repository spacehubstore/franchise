---
// «One floor, dozens of tenants» (Figma 1819:1403). На десктопе блок «прилипает», пункты переключаются прокруткой.
// Под каждым пунктом – объясняющая изометрическая анимация в стиле лендинга (белые боксы, оранжевые рамки дверей,
// как 3D-иконки Figma): CMO 22.11.2026. Сцены собираются при сборке (lib/iso.ts), анимация – CSS по классу .is-on.
// Тексты пунктов – макет v7 и решения CMO (второй уровень «до 80 %», 20.10.2026); 2,5–3× – макет v7.
import { box, grid, slab, pt, type Iso } from "../lib/iso";
const items = [
  { t: "Small units rent for more", d: "The same m² earns 2.5–3× more in small units than leased whole" },
  { t: "A second level adds area", d: "Where the ceiling allows, a second level adds up to 80% more rentable area" },
  { t: "No staff on site", d: "Customers book, pay and open their unit in the app 24/7. Our dispatch centre watches every facility on CCTV" },
  { t: "Dozens of tenants, steady revenue", d: "If one tenant leaves, income dips by a few percent" },
];

// 1. одно помещение целиком → 12 боксов
const v1: Iso = { s: 37, ox: 236, oy: 96 };
const s1 = slab(v1, 0, 0, 10, 6) +
  box(v1, 0.15, 0.15, 0, 9.7, 5.7, 1.8, { cls: "whole", door: "grey" }) +
  grid(v1, { x0: 0.2, y0: 0.2, cols: 4, rows: 3, w: 2.3, d: 1.75, h: 1.8, gap: 0.15 });

// 2. второй уровень: нижний ярус, оранжевый настил, верхний ярус падает сверху
const v2: Iso = { s: 44, ox: 183, oy: 150 };
const s2 = slab(v2, 0, 0, 9.7, 3.55) +
  grid(v2, { x0: 0.1, y0: 0.1, cols: 5, rows: 2, w: 1.8, d: 1.6, h: 1.5, gap: 0.12 }) +
  box(v2, 0.05, 0.05, 1.5, 9.55, 3.4, 0.12, { door: "none", cls: "mez" }) +
  grid(v2, { x0: 0.1, y0: 0.1, z: 1.62, cols: 5, rows: 2, w: 1.8, d: 1.6, h: 0.9, gap: 0.12, cls: () => "up" });

// 3. бокс открывается из приложения
const v3: Iso = { s: 64, ox: 410, oy: 222 };
const P3 = (x: number, y: number, z: number) => pt(v3, x, y, z);
const q = (ps: [number, number][]) => ps.map((p) => p.map((n) => n.toFixed(1)).join(",")).join(" ");
const Y = 2.6, dx0 = 0.4, dx1 = 2.8, dz = 2.55, fr = 0.09;
const doorFrame = q([P3(dx0, Y, 0), P3(dx1, Y, 0), P3(dx1, Y, dz), P3(dx0, Y, dz)]);
const doorIn = q([P3(dx0 + fr, Y, 0), P3(dx1 - fr, Y, 0), P3(dx1 - fr, Y, dz - fr), P3(dx0 + fr, Y, dz - fr)]);
const hinge = P3(dx0 + fr, Y, 0);
const lock = P3(dx1 - 0.3, Y, 1.2);
const s3 = box(v3, 0, 0, 0, 3.2, Y, 3, { door: "none" }) +
  `<polygon class="d-or" points="${doorFrame}"/><polygon class="dark" points="${doorIn}"/>` +
  box(v3, 0.75, 2.0, 0, 0.9, 0.55, 0.75, { door: "none", cls: "cargo" }) +
  box(v3, 1.75, 2.1, 0, 0.6, 0.45, 0.5, { door: "none", cls: "cargo" }) +
  `<g class="swing" style="transform-origin:${hinge[0].toFixed(1)}px ${hinge[1].toFixed(1)}px"><polygon class="d-panel" points="${doorIn}"/>` +
  `<circle class="lock" cx="${lock[0].toFixed(1)}" cy="${lock[1].toFixed(1)}" r="7"/></g>`;
const lockXY = lock;

// 4. один арендатор против 16 боксов
const vL: Iso = { s: 40, ox: 150, oy: 120 }, vR: Iso = { s: 40, ox: 450, oy: 120 };
const GONE = 13;   // передний ряд, дверь видна
const s4 = slab(vL, -0.1, -0.1, 3.7, 3.7) + box(vL, 0, 0, 0, 3.5, 3.5, 2, { cls: "big" }) +
  slab(vR, -0.1, -0.1, 3.7, 3.7) +
  grid(vR, { x0: 0, y0: 0, cols: 4, rows: 4, w: 0.8, d: 0.8, h: 0.95, gap: 0.1, cls: (i) => (i === GONE ? "gone" : "") });
---
<section class="fl" data-floor style={`--n:${items.length}`}>
  <div class="fl__stick">
    <div class="fl__in wrap">
      <div class="fl__head">
        <h2>One floor, dozens of tenants</h2>
        <p>Self-storage splits a space into lockable units that people and small businesses rent by the month</p>
      </div>
      <div class="fl__body">
        <div class="fl__left">
          <ol class="acc">
            {items.map((it, i) => (
              <li class={`acc__it ${i === 0 ? "is-on" : ""}`} data-i={i}>
                <button type="button" class="acc__t">{it.t}</button>
                <p class="acc__d">{it.d}</p>
                <i class="acc__bar"><b></b></i>
                <div class="vis vis--inline" data-vis={i}></div>
              </li>
            ))}
          </ol>
          <div class="stat">
            <img class="stat__glow" src="/assets/figma/glow-49.svg" alt="" aria-hidden="true" />
            <b>+7–8%</b>
            <span>a year: self-storage market growth in the Middle East, Africa and Asia Pacific</span>
          </div>
        </div>

        <div class="stage" aria-hidden="true">
          <div class="vis sc s1 is-on" data-vis="0">
            <svg viewBox="0 0 600 420"><Fragment set:html={s1} /></svg>
            <div class="chip chip--a"><b>1 tenant</b><span>the whole floor at one rent</span></div>
            <div class="chip chip--b"><b>12 units</b><span>2.5–3× more per m²</span></div>
          </div>

          <div class="vis sc s2" data-vis="1">
            <svg viewBox="0 0 600 440"><Fragment set:html={s2} /></svg>
            <div class="chip chip--top"><b>+80%</b><span>rentable area</span></div>
          </div>

          <div class="vis sc s3" data-vis="2">
            <svg viewBox="0 0 600 440">
              <image href="/assets/figma/inc-phone.webp" x="0" y="40" width="230" height="360" preserveAspectRatio="xMidYMid meet" />
              <circle class="tap" cx="118" cy="300" r="10" />
              <path class="sig" d={`M150 250 C 230 160, 300 170, ${lockXY[0].toFixed(0)} ${lockXY[1].toFixed(0)}`} />
              <Fragment set:html={s3} />
            </svg>
            <ol class="steps3"><li>Booked online</li><li>Paid in the app</li><li>Unit opened</li></ol>
          </div>

          <div class="vis sc s4" data-vis="3">
            <svg viewBox="0 0 600 400">
              <Fragment set:html={s4} />
              <text x="150" y="300" class="t4">1 tenant</text>
              <text x="450" y="300" class="t4">16 tenants</text>
              <rect x="50" y="318" width="200" height="12" rx="6" class="track" /><rect x="50" y="318" width="200" height="12" rx="6" class="bar bar--l" />
              <rect x="350" y="318" width="200" height="12" rx="6" class="track" /><rect x="350" y="318" width="200" height="12" rx="6" class="bar bar--r" />
              <text x="150" y="356" class="v4 v4--a">Income 100%</text><text x="150" y="356" class="v4 v4--b v4--bad">Income 0%</text>
              <text x="450" y="356" class="v4 v4--a">Income 100%</text><text x="450" y="356" class="v4 v4--b">Income 94%</text>
              <text x="300" y="392" class="cap4">One tenant leaves</text>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const sec = document.querySelector<HTMLElement>("[data-floor]")!;
  const items = Array.from(sec.querySelectorAll<HTMLElement>(".acc__it"));
  const vis = Array.from(sec.querySelectorAll<HTMLElement>(".stage .vis"));
  const n = items.length;
  const desk = matchMedia("(min-width: 1101px)");
  // на мобильном сцена встраивается под каждый пункт
  items.forEach((it, i) => { const c = vis[i].cloneNode(true) as HTMLElement; c.classList.remove("is-on"); it.querySelector(".vis--inline")!.replaceWith(c); });
  let active = -1;
  const show = (i: number) => {
    if (i === active) return; active = i;
    items.forEach((it, k) => it.classList.toggle("is-on", k === i));
    vis.forEach((v, k) => v.classList.toggle("is-on", k === i));
  };
  const onScroll = () => {
    if (!desk.matches) return;
    const r = sec.getBoundingClientRect(), span = sec.offsetHeight - innerHeight;
    const p = Math.min(Math.max(-r.top / Math.max(span, 1), 0), 0.9999);
    const i = Math.floor(p * n); show(i);
    items.forEach((it, k) => it.style.setProperty("--p", String(k < i ? 1 : k > i ? 0 : p * n - i)));
  };
  addEventListener("scroll", onScroll, { passive: true }); addEventListener("resize", onScroll); onScroll();
  items.forEach((it, i) => it.querySelector("button")!.addEventListener("click", () => {
    if (desk.matches) { const top = sec.getBoundingClientRect().top + scrollY + (sec.offsetHeight - innerHeight) * (i + 0.15) / n; scrollTo({ top, behavior: "smooth" }); }
  }));
  // мобильный: сцена запускается, когда попадает в экран
  const io = new IntersectionObserver((es) => es.forEach((e) => e.isIntersecting && e.target.classList.add("is-on")), { threshold: .45 });
  items.forEach((it) => io.observe(it.querySelector(".vis")!));
</script>

<style>
  .fl { position: relative; height: calc(100svh * (var(--n) * 0.75 + 0.6)); }
  .fl__stick { position: sticky; top: var(--hdr-h); min-height: calc(100svh - var(--hdr-h)); display: flex; align-items: center; padding-block: 32px; }
  .fl__in { width: 100%; display: flex; flex-direction: column; gap: 40px; }
  .fl__head { max-width: 768px; margin: 0 auto; text-align: center; display: flex; flex-direction: column; gap: 16px; }
  .fl__head h2 { font-weight: 700; font-size: 48px; line-height: 54px; }
  .fl__head p { font-weight: 500; font-size: 20px; line-height: 28px; color: var(--gray-600); }
  .fl__body { display: flex; gap: 40px; width: 100%; max-width: 1296px; margin: 0 auto; align-items: stretch; }
  .fl__left { width: 424px; flex: none; display: flex; flex-direction: column; justify-content: space-between; gap: 24px; }
  .acc { list-style: none; }
  .acc__it { padding: 20px 0; border-bottom: 1px solid var(--gray-200); }
  .acc__t { font-weight: 700; font-size: 24px; line-height: 28px; letter-spacing: -0.48px; color: var(--gray-400); text-align: left; transition: color .3s; }
  .acc__d { max-height: 0; overflow: hidden; opacity: 0; font-weight: 500; font-size: 16px; line-height: 24px; letter-spacing: 0.16px; transition: max-height .45s, opacity .35s, margin .35s; }
  .acc__bar { display: block; height: 2px; margin-top: 16px; background: var(--gray-100); border-radius: 2px; overflow: hidden; opacity: 0; transition: opacity .3s; }
  .acc__bar b { display: block; height: 100%; width: calc(var(--p, 0) * 100%); background: var(--brand); }
  .acc__it.is-on .acc__t { color: var(--gray-900); }
  .acc__it.is-on .acc__d { max-height: 120px; opacity: 1; margin-top: 10px; }
  .acc__it.is-on .acc__bar { opacity: 1; }
  .acc__it > .vis { display: none; }

  .stat { position: relative; overflow: hidden; background: var(--gray-100); border-radius: var(--radius-l); padding: 24px; display: flex; flex-direction: column; gap: 10px; }
  .stat__glow { position: absolute; right: -100px; top: -63px; width: 418px; max-width: none; pointer-events: none; }
  .stat b { position: relative; font-weight: 700; font-size: 44px; line-height: 1; color: var(--brand); }
  .stat span { position: relative; font-weight: 500; font-size: 15px; line-height: 22px; }

  .stage { position: relative; flex: 1; min-width: 0; min-height: 540px; border-radius: var(--radius-l); background: radial-gradient(120% 90% at 70% 20%, #fff 0%, #fff 45%, #fdf1ea 100%); border: 1px solid var(--gray-200); overflow: hidden; }
  .vis { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; opacity: 0; transition: opacity .45s; pointer-events: none; }
  .vis.is-on { opacity: 1; }
  .sc svg { width: 92%; max-height: 92%; overflow: visible; }

  /* грани боксов */
  .sc :global(.f-top) { fill: #fff; }
  .sc :global(.f-l) { fill: #f4f4f5; }
  .sc :global(.f-r) { fill: #e4e4e7; }
  .sc :global(.f-floor) { fill: #f4f4f5; }
  .sc :global(polygon) { stroke: #d1d1d6; stroke-width: .8; stroke-linejoin: round; }
  .sc :global(.d-or) { fill: var(--brand); stroke: none; }
  .sc :global(.d-grey) { fill: var(--gray-400); stroke: none; }
  .sc :global(.d-panel) { fill: #fff; stroke: none; }
  .sc :global(.u), .sc :global(.whole), .sc :global(.mez), .sc :global(.swing) { transform-box: view-box; }

  /* 1: целиком → боксы */
  .s1 :global(.u) { opacity: 0; transform: translateY(-34px); }
  .s1.is-on :global(.whole) { animation: out .45s 1.3s forwards; }
  .s1.is-on :global(.u) { animation: drop .5s cubic-bezier(.2,1.25,.4,1) calc(1.5s + var(--i) * .09s) forwards; }
  .chip { position: absolute; display: flex; flex-direction: column; background: var(--white); border-radius: 16px; padding: 12px 16px; box-shadow: 0 12px 30px rgba(0,0,0,.08); }
  .chip b { font-weight: 700; font-size: 22px; line-height: 26px; }
  .chip span { font-size: 13px; line-height: 18px; color: var(--gray-500); }
  .chip--a { left: 6%; top: 8%; }
  .chip--b { right: 6%; top: 8%; background: var(--brand); color: var(--white); opacity: 0; transform: translateY(10px); }
  .chip--b span { color: rgba(255,255,255,.85); }
  .s1.is-on .chip--a { animation: out .4s 1.3s forwards; }
  .s1.is-on .chip--b { animation: in .5s 2.2s forwards; }

  /* 2: второй уровень */
  .s2 :global(.mez) { opacity: 0; }
  .s2 :global(.mez polygon) { fill: var(--brand); stroke: #e04400; }
  .s2 :global(.up) { opacity: 0; transform: translateY(-60px); }
  .s2.is-on :global(.mez) { animation: in .4s .5s forwards; }
  .s2.is-on :global(.up) { animation: drop .55s cubic-bezier(.2,1.25,.4,1) calc(.9s + var(--i) * .1s) forwards; }
  .chip--top { right: 6%; top: 7%; background: var(--brand); color: var(--white); opacity: 0; transform: translateY(10px); }
  .chip--top b { font-size: 34px; line-height: 36px; }
  .chip--top span { color: rgba(255,255,255,.85); }
  .s2.is-on .chip--top { animation: in .5s 1.9s forwards; }

  /* 3: приложение открывает бокс */
  .s3 :global(.dark) { fill: #3f3f46; stroke: none; }
  .s3 :global(.cargo polygon) { fill: #e8c9a8; stroke: #c9a27c; }
  .s3 :global(.cargo .f-top) { fill: #f3dcc2; }
  .s3 :global(.lock) { fill: var(--brand); }
  .s3.is-on :global(.swing) { animation: swing .8s cubic-bezier(.5,0,.3,1) 1.7s forwards; }
  .tap { fill: none; stroke: var(--brand); stroke-width: 3; opacity: 0; transform-box: fill-box; transform-origin: center; }
  .s3.is-on .tap { animation: tap .9s .4s 2 ease-out; }
  .sig { fill: none; stroke: var(--brand); stroke-width: 3; stroke-dasharray: 6 8; stroke-dashoffset: 0; opacity: 0; }
  .s3.is-on .sig { animation: in .3s .9s forwards, flow 1s linear .9s 3; }
  .steps3 { position: absolute; right: 5%; top: 6%; list-style: none; display: flex; flex-direction: column; gap: 8px; }
  .steps3 li { background: var(--white); border-radius: 100px; padding: 8px 14px; font-weight: 600; font-size: 14px; box-shadow: 0 8px 22px rgba(0,0,0,.08); opacity: 0; transform: translateX(10px); }
  .steps3 li::before { content: ""; display: inline-block; width: 8px; height: 8px; margin-right: 8px; border-radius: 50%; background: var(--brand); vertical-align: 1px; }
  .s3.is-on .steps3 li { animation: in .4s forwards; }
  .s3.is-on .steps3 li:nth-child(1) { animation-delay: .3s; }
  .s3.is-on .steps3 li:nth-child(2) { animation-delay: 1s; }
  .s3.is-on .steps3 li:nth-child(3) { animation-delay: 1.8s; }

  /* 4: уход одного арендатора */
  .t4 { font: 700 22px "Manrope", sans-serif; fill: var(--gray-900); text-anchor: middle; }
  .track { fill: var(--gray-100); }
  .bar { fill: var(--brand); transform-box: fill-box; transform-origin: left; }
  .v4 { font: 600 18px "Manrope", sans-serif; fill: var(--gray-500); text-anchor: middle; }
  .v4--b { opacity: 0; }
  .v4--bad { fill: var(--gray-900); }
  .cap4 { font: 500 16px "Manrope", sans-serif; fill: var(--gray-400); text-anchor: middle; opacity: 0; }
  .s4.is-on .bar--l { animation: shrink0 .8s 1.4s forwards; }
  .s4.is-on .bar--r { animation: shrink94 .8s 1.4s forwards; }
  .s4.is-on .v4--a { animation: out .3s 1.4s forwards; }
  .s4.is-on .v4--b, .s4.is-on .cap4 { animation: in .3s 1.5s forwards; }
  .s4.is-on :global(.big .d-or), .s4.is-on :global(.gone .d-or) { animation: grey .4s 1.1s forwards; }
  .s4.is-on :global(.gone) { animation: lift .5s 1.1s forwards; }

  @keyframes drop { from { opacity: 0; transform: translateY(-34px); } to { opacity: 1; transform: none; } }
  @keyframes in { to { opacity: 1; transform: none; } }
  @keyframes out { to { opacity: 0; } }
  @keyframes swing { to { transform: scaleX(.14); } }
  @keyframes tap { 0% { opacity: .9; transform: scale(.6); } 100% { opacity: 0; transform: scale(3); } }
  @keyframes flow { to { stroke-dashoffset: -28; } }
  @keyframes grey { to { fill: var(--gray-400); } }
  @keyframes lift { 50% { transform: translateY(-8px); } to { transform: none; } }
  @keyframes shrink0 { to { transform: scaleX(0); } }
  @keyframes shrink94 { to { transform: scaleX(.94); } }

  @media (max-width: 1100px) {
    .fl { height: auto; }
    .fl__stick { position: static; min-height: 0; padding-block: 64px; }
    .fl__in { gap: 28px; }
    .fl__head h2 { font-size: 32px; line-height: 38px; }
    .fl__head p { font-size: 17px; line-height: 24px; }
    .fl__body { flex-direction: column; }
    .fl__left { width: 100%; }
    .stage { display: none; }
    .acc__t { font-size: 20px; line-height: 24px; color: var(--gray-900); }
    .acc__d { max-height: none; opacity: 1; margin-top: 8px; }
    .acc__bar { display: none; }
    .acc__it > .vis { display: flex; position: relative; opacity: 1; height: 320px; margin-top: 16px; border-radius: 20px; border: 1px solid var(--gray-200); background: radial-gradient(120% 90% at 70% 20%, #fff 0%, #fff 45%, #fdf1ea 100%); overflow: hidden; }
    .chip { padding: 8px 12px; } .chip b { font-size: 17px; line-height: 20px; } .chip span { font-size: 11px; line-height: 14px; }
    .chip--top b { font-size: 24px; line-height: 26px; }
    .steps3 li { font-size: 11px; padding: 6px 10px; }
  }
</style>
