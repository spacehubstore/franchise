---
// «One floor, dozens of tenants» (Figma 1819:1403). Автопоказ (CMO 22.11.2026): пункты сменяются сами, когда блок виден;
// полоска прогресса под активным пунктом, клик переключает, наведение – пауза. Заголовок в левой колонке, высота сцены – от окна.
// Ролики 4 с в стиле 3D-иллюстраций квиза (кадры Nano Banana Pro, движение Gemini Omni Flash, `hub/06-directions/franchise/
// landing-icons/gen_floor_google.py`, `gen_floor_v2.py`) идут ×1,6: пункт ~4 с – столько держится внимание на строке и картинке.
// Подписи – одна плашка на сцену в одном месте: «до» на старте, «после» в момент окончания ролика (CMO 22.11.2026:
// подписи должны читаться вместе с анимацией). Смена пункта – по факту окончания ролика, не по таймеру.
// Тексты пунктов – макет v7 и решения CMO (второй уровень «до 80 %», 20.10.2026); 2,5–3× – макет v7; 25 и 96 % – по планировке сцены.
const items = [
  // заголовки – CMO 22.11.2026; «up to 4–5×» (заголовок и плашка сцены 1) – кейсы лендинга: Шарджа 4,8× (ставки модели Романенкова 24.09), Бангкок ~4,6× (F-1783)
  { t: "Same space, up to 4–5× the income", d: "Small units rent for more per m² than one tenant leasing the whole floor" },
  { t: "Up to 80% more space to rent", d: "Where the ceiling allows, a loft tier of smaller units goes above the main ones" },
  { t: "No staff on site", d: "Customers book, pay and open their unit in the app 24/7. Every facility is equipped with CCTV cameras" },
  { t: "Steady cash flow every month", d: "Dozens of tenants pay monthly. If one leaves, income dips by a few percent" },
];
const F = (s: string) => ({ a: `/assets/floor/${s}-a.webp`, b: `/assets/floor/${s}-b.webp` });
const V = (s: string) => `/assets/floor/${s}.mp4`;
import { langOf, useT } from "../i18n";
const lang = langOf(Astro.url.pathname);
const t = useT(lang);
---
<section class="fl wrap" data-floor>
  <div class="fl__grid">
    <div class="fl__left">
      <div class="fl__head">
        <h2>{t("One floor, dozens of tenants")}</h2>
        <p>{t("Self-storage splits a space into lockable units that people and small businesses rent by the month")}</p>
      </div>
      <ol class="acc">
        {items.map((it, i) => (
          <li class={`acc__it ${i === 0 ? "is-on" : ""}`} data-i={i}>
            <button type="button" class="acc__t"><span class="acc__n">0{i + 1}</span>{t(it.t)}</button>
            <p class="acc__d">{t(it.d)}</p>
            <i class="acc__bar"><b></b></i>
            <div class="vis vis--inline" data-vis={i}></div>
          </li>
        ))}
      </ol>
      <div class="stat">
        <img class="stat__glow" src="/assets/figma/glow-49.svg" alt="" aria-hidden="true" />
        <b>$62B</b>
        <!-- Grand View Research: мировой рынок self-storage $61,7 млрд (2025) → $104,8 млрд (2033), CAGR 7,1 % (2026–2033); проверено 22.11.2026 -->
        <span>{t("global self-storage market, growing 7% a year")}<small>{t("Source:")} <a href="https://www.grandviewresearch.com/industry-analysis/self-storage-market-report" target="_blank" rel="noopener nofollow">Grand View Research</a>{t(", 2025 size, 2026–2033 forecast")}</small></span>
      </div>
    </div>

    <div class="stage" aria-hidden="true">
      <div class="vis sc s1 is-on" data-vis="0">
        <div class="fr"><video src={V("s1")} poster={F("s1").a} muted playsinline preload="metadata"></video></div>
        <div class="cap cap--static">
          <div class="cap__a"><small>{t("Small units")}</small><b>{t("4–5× the income")}</b><span>{t("small units rent for more per m² than one big lease")}</span></div>
        </div>
      </div>

      <div class="vis sc s2" data-vis="1">
        <div class="fr"><video src={V("s2")} poster={F("s2").a} muted playsinline preload="metadata"></video></div>
        <div class="cap cap--static">
          <div class="cap__a"><small>{t("Loft tier")}</small><b>{t("+80% area")}</b><span>{t("from the same space, above the units")}</span></div>
        </div>
      </div>

      <div class="vis sc s3" data-vis="2">
        <div class="fr fr--s3"><video src={V("s3")} poster={F("s3").a} muted playsinline preload="metadata" data-pre="900"></video></div>
        <div class="phone"><img src="/assets/figma/inc-phone.webp" alt="" loading="lazy" /><div class="slide"><span class="slide__t slide__t--a">{t("Open")}</span><span class="slide__t slide__t--b">{t("Unlocked")}</span><i class="knob"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path class="shackle" d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></i></div></div>
        <svg class="sig" viewBox="0 0 100 40" preserveAspectRatio="none"><path d="M2 30 C 30 2, 70 2, 98 24" /></svg>
        <div class="cap cap--static">
          <div class="cap__a"><small>{t("Self-service, 24/7")}</small><b>{t("Nobody to hire")}</b><span>{t("customers book, pay and open units themselves")}</span></div>
        </div>
      </div>

      <div class="vis sc s4" data-vis="3" data-ms="3000" data-chart>
        <div class="cap cap--static">
          <div class="cap__a"><small>{t("Monthly income, 12 months")}</small><b>{t("No month at zero")}</b><span>{t("one tenant leaving can't stop your income")}</span></div>
        </div>
        <div class="ln">
          <svg viewBox="0 0 560 230" aria-hidden="true">
            <line class="ln__g" x1="40" y1="200" x2="460" y2="200" /><line class="ln__g" x1="40" y1="115" x2="460" y2="115" /><line class="ln__g" x1="40" y1="30" x2="460" y2="30" />
            <text class="ln__ax" x="34" y="204">$0</text><text class="ln__ax" x="34" y="119">$6k</text><text class="ln__ax" x="34" y="34">$12k</text>
            <defs><clipPath id="ln-clip"><rect class="ln__clip" x="0" y="0" width="0" height="230" /></clipPath></defs>
            <g clip-path="url(#ln-clip)"><path class="ln__one" d="" /><path class="ln__many" d="" /></g>
            <text class="ln__ax ln__m" x="40" y="222">{t("Month 1")}</text><text class="ln__ax ln__m ln__end" x="460" y="222">12</text>
          </svg>
          <div class="ln__lab ln__lab--many" data-l="many"><b>{t("25 tenants")}</b><span>$9,700</span></div>
          <div class="ln__lab ln__lab--one" data-l="one"><b>{t("1 tenant")}</b><span>$2,220</span></div>
          <i class="ln__dot ln__dot--many" data-h="many"></i><i class="ln__dot ln__dot--one" data-h="one"></i>
        </div>
        <p class="foot">{t("Sharjah, 185 m², SpaceHub model, after management commission. Tenant changes illustrative")}</p>
      </div>
      <span class="stage__n" data-count>1 / {items.length}</span>
    </div>
  </div>
</section>

<script>
  import { slowNet } from "../lib/net";
  import { cover, uncover } from "../lib/vframe";
  import { FOCUS } from "../lib/focus";
  // холодный трафик (CMO 22.11.2026): пункт ~2,5–3 с, круг ~11 с; плашка «После» – на 2/3 ролика, пока картинка ещё движется
  const RATE = 2.2, HOLD = 800, CAP_AT = .66;
  const sec = document.querySelector<HTMLElement>("[data-floor]")!;
  const items = Array.from(sec.querySelectorAll<HTMLElement>(".acc__it"));
  const vis = Array.from(sec.querySelectorAll<HTMLElement>(".stage .vis"));
  const count = sec.querySelector<HTMLElement>("[data-count]")!;
  const n = items.length;
  const desk = matchMedia("(min-width: 1101px)");
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches || slowNet;
  if (slowNet) sec.querySelectorAll<HTMLVideoElement>("video").forEach((v) => { v.preload = "none"; v.removeAttribute("src"); v.load(); });
  items.forEach((it, i) => { const c = vis[i].cloneNode(true) as HTMLElement; c.classList.remove("is-on"); it.querySelector(".vis--inline")!.replaceWith(c); });

  // сцена: «до» → свайп (сцена 3) → ролик ×2,2 → на 2/3 ролика плашка «после» (.is-cap) → конец ролика (.is-done)
  type S = HTMLElement & { _t?: number; _d?: number; _end?: number; _start?: number };
  function start(sc: S) {
    sc.classList.remove("is-on", "is-done", "is-cap"); void sc.offsetWidth; sc.classList.add("is-on");
    sc._end = 0; sc._start = performance.now();
    const v = sc.querySelector("video");
    if (!v) { clearTimeout(sc._t); clearTimeout(sc._d); if (sc.dataset.chart !== undefined) runChart(sc, still);
              if (still) { sc.classList.add("is-done", "is-cap"); sc._end = performance.now(); return; }
              sc._t = window.setTimeout(() => sc.classList.add("is-cap"), +(sc.dataset.ms || 1200) * .66);
              sc._d = window.setTimeout(() => { sc.classList.add("is-done", "is-cap"); sc._end = performance.now(); seen(sc); }, +(sc.dataset.ms || 1200)); return; }
    clearTimeout(sc._t); v.pause();
    if (still) { uncover(v); v.poster = v.poster.replace("-a.webp", "-b.webp"); sc.classList.add("is-done", "is-cap"); sc._end = performance.now(); return; }
    cover(v);   // кадр «до» поверх ролика, пока первый кадр не нарисован – без пустого кадра на старте
    if (v.currentTime) v.currentTime = 0;
    v.onended = () => { sc.classList.add("is-done", "is-cap"); sc._end = performance.now(); seen(sc); };
    sc._t = window.setTimeout(() => { v.playbackRate = RATE; v.play().catch(() => { sc.classList.add("is-done", "is-cap"); sc._end = performance.now(); }); }, +(v.dataset.pre || 0));
  }

  // график сцены 4 (CMO 22.11.2026): доход в $ за 12 месяцев. 25 арендаторов × $388 = $9,700 и 1 арендатор $2,220 (Шарджа, модель Романенкова 24.09),
  // 1 арендатор $3,000; арендаторы уходят и приходят (иллюстрация). Линии и подписи на их концах бегут слева направо, события ±N всплывают
  const MANY = [25, 25, 24, 24, 25, 26, 25, 23, 24, 25, 26, 25], ONE = [1, 1, 1, 1, 1, 0, 0, 0, 1, 1, 1, 1];
  const X = (m: number) => 40 + m * (420 / 11), Y = (usd: number) => 200 - usd * 170 / 12000;
  const usd = (n: number) => "$" + Math.round(n).toLocaleString("en-US");
  const pts = (arr: number[], per: number) => arr.map((n, m) => [X(m), Y(n * per)] as [number, number]);
  const smooth = (p: [number, number][]) => p.reduce((d, [x, y], i) => {
    if (!i) return `M${x} ${y}`;
    const [x0, y0] = p[i - 1], cx = (x - x0) / 2;
    return d + ` C${x0 + cx} ${y0} ${x - cx} ${y} ${x} ${y}`;
  }, "");
  function runChart(sc: HTMLElement, instant: boolean) {
    const svg = sc.querySelector("svg")!, box = sc.querySelector<HTMLElement>(".ln")!;
    const P = { many: pts(MANY, 388), one: pts(ONE, 2220) };
    svg.querySelector(".ln__many")!.setAttribute("d", smooth(P.many));
    svg.querySelector(".ln__one")!.setAttribute("d", smooth(P.one));
    // у копии сцены в мобильном списке тот же id – делаем свой, иначе линии режет чужой clipPath
    const cp = svg.querySelector("clipPath")!, id = "ln-" + Math.random().toString(36).slice(2, 8);
    cp.id = id; svg.querySelector("g[clip-path]")!.setAttribute("clip-path", `url(#${id})`);
    const clip = svg.querySelector<SVGRectElement>(".ln__clip")!;
    const heads = { many: box.querySelector<HTMLElement>('[data-h="many"]')!, one: box.querySelector<HTMLElement>('[data-h="one"]')! };
    const labs = { many: box.querySelector<HTMLElement>('[data-l="many"]')!, one: box.querySelector<HTMLElement>('[data-l="one"]')! };
    box.querySelectorAll(".ln__ev").forEach((e) => e.remove());
    const D = instant ? 0 : 2400, t0 = performance.now(); let lastM = 0;
    const place = (el: HTMLElement, x: number, y: number) => {
      const r = svg.getBoundingClientRect(), k = r.width / 560;
      el.style.left = `${x * k}px`; el.style.top = `${y * k}px`;
    };
    const ev = (x: number, y: number, txt: string, up: boolean) => {
      const e = document.createElement("i"); e.className = "ln__ev" + (up ? " ln__ev--up" : ""); e.textContent = txt;
      box.appendChild(e); place(e, x, y); e.addEventListener("animationend", () => e.remove());
    };
    const frame = (now: number) => { try {
      const p = D ? Math.min(1, Math.max(0, (now - t0) / D)) : 1, xm = 40 + 420 * p, m = Math.min(11, Math.floor(p * 11 + 1e-6));
      clip.setAttribute("width", String(xm));
      for (const k of ["many", "one"] as const) {
        const arr = k === "many" ? MANY : ONE, per = k === "many" ? 388 : 2220, pp = P[k];
        const f = Math.min(1, p * 11 - m), y = m < 11 ? pp[m][1] + (pp[m + 1][1] - pp[m][1]) * (3 * f * f - 2 * f * f * f) : pp[11][1];
        place(heads[k], xm, y);
        place(labs[k], 40, pp[0][1]);
        const lb = labs[k].querySelector("b")!, lv = labs[k].querySelector("span")!, nt = `${arr[m]} tenant${arr[m] === 1 ? "" : "s"}`;
        if (lb.textContent !== nt) { lb.textContent = nt; lv.textContent = usd(arr[m] * per); labs[k].classList.remove("blip"); void labs[k].offsetWidth; labs[k].classList.add("blip"); }
        if (D && m > lastM) for (let j = lastM + 1; j <= m; j++) {
          const dn = arr[j] - arr[j - 1];
          if (dn) ev(X(j), pp[j][1], (dn > 0 ? "+" : "−") + Math.abs(dn), dn > 0);
        }
      }
      lastM = m;
      if (p < 1 && sc.classList.contains("is-on")) requestAnimationFrame(frame);
    } catch (e) { console.error("chart", e); } };
    requestAnimationFrame(frame);
  }
  // сколько сцены уже показано: у ролика – по его фактическому времени (ролик догружается – полоска ждёт вместе с ним)
  const elapsed = (sc: S, now: number) => { const v = sc.querySelector("video"), w = now - (sc._start || now); if (!v) return w;
    const pre = +(v.dataset.pre || 0); return v.currentTime > 0 ? pre + 1000 * v.currentTime / RATE : Math.min(pre, w); };
  const expected = (sc: S) => { const v = sc.querySelector("video"); if (!v) return +(sc.dataset.ms || 1200); return +(v.dataset.pre || 0) + 1000 * (v.duration || 4) / RATE; };

  // автопоказ: следующий пункт – через HOLD после окончания ролика; полоска – доля ожидаемого времени
  let active = 0, inView = false, hover = false, manual = false;
  // ручной выбор пункта (CMO 23.11.2026) останавливает автопоказ: выбранный пункт остаётся, пока блок не ушёл с экрана;
  // блок вернулся в экран – автопоказ заново с первого пункта
  const running = () => desk.matches && inView && !hover && !manual && !document.hidden && !still;
  function go(i: number) {
    active = (i + n) % n;
    items.forEach((it, k) => { it.classList.toggle("is-on", k === active); it.style.setProperty("--p", "0"); });
    vis.forEach((v, k) => { if (k !== active) { v.classList.remove("is-on", "is-done", "is-cap"); v.querySelector("video")?.pause(); } });
    count.textContent = `${active + 1} / ${n}`;
    start(vis[active] as S);
  }
  function tick(now: number) {
    const sc = vis[active] as S;
    if (running() && sc._start) {
      const total = expected(sc) + HOLD;
      const p = sc._end ? Math.min(1, (expected(sc) + (now - sc._end)) / total) : Math.min(.98 * expected(sc) / total, elapsed(sc, now) / total);
      items[active].style.setProperty("--p", String(p));
      if (sc._end && now - sc._end >= HOLD) go(active + 1);
      // ролик не дошёл до конца за ожидаемое время + 4 с (сеть) – показываем «после» и идём дальше
      else if (!sc._end && now - sc._start > expected(sc) + 4000) { sc.classList.add("is-done", "is-cap"); sc._end = now; }
    }
    requestAnimationFrame(tick);
  }
  // наведение останавливает только автопереключение, ролик доигрывает (CMO 23.11.2026: раньше ролик вставал на паузу, и после клика
  // по пункту под курсором время наведения переносилось на новую сцену – следующее переключение откладывалось на те же секунды).
  // Курсор ушёл: досмотренная сцена держится ещё HOLD и идёт дальше
  const leave = () => { const sc = vis[active] as S; if (sc._end) sc._end = Math.max(sc._end, performance.now() - HOLD / 2); };
  new IntersectionObserver((es) => {
    const was = inView; inView = es[0].intersectionRatio >= .3;
    if (inView && !was && desk.matches) { manual = false; go(0); }
  }, { threshold: [0, .3] }).observe(sec.querySelector(".stage")!);
  // ролики грузятся по очереди, первый – раньше всех (CMO 23.11.2026: первая сцена подвисала – четыре ролика качались разом,
  // и первый догружался дольше, чем шла сцена). Следующий – когда предыдущий загружен целиком или через 4 с
  const chain = (vs: HTMLVideoElement[], k = 0) => {
    const v = vs[k]; if (!v || v.dataset.q) return; v.dataset.q = "1"; v.preload = "auto";
    let go = false; const next = () => { if (!go) { go = true; chain(vs, k + 1); } };
    if (v.readyState >= 4) return next();
    v.addEventListener("canplaythrough", next, { once: true }); v.addEventListener("error", next, { once: true }); setTimeout(next, 4000);
  };
  if (!still) new IntersectionObserver((es, o) => { if (!es[0].isIntersecting) return; o.disconnect();
    chain(Array.from(sec.querySelectorAll<HTMLVideoElement>(desk.matches ? ".stage video" : ".acc__it video")));
  }, { rootMargin: "100% 0px" }).observe(sec);
  // вкладку скрыли и вернули: браузер ставил ролик на паузу – продолжаем с того же места, время скрытия не засчитываем
  let hiddenAt = 0;
  document.addEventListener("visibilitychange", () => {
    if (document.hidden) { hiddenAt = performance.now(); return; }
    const sc = vis[active] as S, d = hiddenAt ? performance.now() - hiddenAt : 0; hiddenAt = 0;
    if (sc._start) sc._start += d; if (sc._end) sc._end += d;
    const v = sc.querySelector("video");
    if (desk.matches && inView && v && v.paused && !v.ended && !sc._end && !still) v.play().catch(() => {});
  });
  sec.addEventListener("mouseenter", () => { hover = true; });
  sec.addEventListener("mouseleave", () => { hover = false; leave(); });
  items.forEach((it, i) => it.querySelector("button")!.addEventListener("click", () => {
    if (desk.matches) { manual = true; go(i); (window as any).dataLayer?.push({ event: "floor_item_clicked", item: i + 1 }); }
  }));
  requestAnimationFrame(tick);
  sec.querySelectorAll<HTMLVideoElement>("video").forEach((v) => v.addEventListener("timeupdate", () => {
    const vs = v.closest(".vis")!; if (v.duration && v.currentTime / v.duration >= CAP_AT && !vs.classList.contains("is-cap")) vs.classList.add("is-cap");
  }));

  // замер для подстройки скорости (CMO 22.11.2026): какой пункт досмотрен (ролик доиграл) и сколько секунд блок был в экране
  const done = new Set<number>(); let shownAt = 0, shownMs = 0;
  function seen(sc: HTMLElement) {
    const i = +(sc.dataset.vis || 0) + 1;
    if (done.has(i)) return; done.add(i);
    (window as any).dataLayer?.push({ event: "floor_item_viewed", item: i, site_variant: location.pathname });
  }
  new IntersectionObserver((es) => {
    const on = es[0].isIntersecting;
    if (on) shownAt = performance.now();
    else if (shownAt) {
      shownMs += performance.now() - shownAt; shownAt = 0;
      (window as any).dataLayer?.push({ event: "floor_block_left", max_item: done.size ? Math.max(...done) : 0,
        seconds_visible: Math.round(shownMs / 1000), site_variant: location.pathname });
    }
  }, { threshold: .3 }).observe(sec);

  // мобильный: сцена проигрывается, когда доходит до середины экрана (lib/focus)
  const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting && !e.target.classList.contains("is-on")) start(e.target as S); }), FOCUS);
  items.forEach((it) => io.observe(it.querySelector(".vis")!));
</script>

<style>
  .fl { padding-block: 64px; }
  .fl__grid { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 48px; align-items: start; max-width: 1296px; margin: 0 auto; }
  .fl__left { display: flex; flex-direction: column; gap: 24px; }
  .fl__head { display: flex; flex-direction: column; gap: 12px; }
  .fl__head h2 { font-weight: 700; font-size: clamp(34px, 3.2vw, 44px); line-height: 1.12; letter-spacing: -1px; text-wrap: balance; }
  .fl__head p { font-weight: 500; font-size: 17px; line-height: 25px; color: var(--gray-600); }
  .acc { list-style: none; }
  .acc__it { padding: 14px 0; border-bottom: 1px solid var(--gray-200); }
  .acc__t { display: flex; gap: 12px; align-items: baseline; font-weight: 700; font-size: 20px; line-height: 26px; letter-spacing: -0.3px; color: var(--gray-400); text-align: left; transition: color .3s; }
  .acc__n { font-size: 13px; font-weight: 600; color: var(--gray-300); font-variant-numeric: tabular-nums; transition: color .3s; }
  .acc__d { height: 0; overflow: hidden; opacity: 0; padding-left: 31px; font-weight: 500; font-size: 15px; line-height: 22px;
            transition: height .4s cubic-bezier(.4,0,.2,1), opacity .3s, margin-top .4s cubic-bezier(.4,0,.2,1); }
