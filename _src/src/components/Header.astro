---
// Шапка (Figma 1531:5928): логотип, «franchise», кнопки «Get in touch» (общее окно заявки) и WhatsApp.
// На первом экране кнопок нет – они дублировали бы кнопки первого экрана; появляются, когда первый экран ушёл (CMO 23.11.2026).
// Свёрнутые кнопки не занимают места, переключатель языка стоит в правом углу (CMO 24.11.2026).
import { CONTACTS } from "../data/site";
const { cta = true } = Astro.props;   // на служебных страницах (политика) – без кнопок
import { langOf, useT, href, messenger, LANGS, LANG_LABEL, LANG_NAME } from "../i18n";
const lang = langOf(Astro.url.pathname);
const t = useT(lang);
const m = messenger(lang);
---
<header class="hdr">
  <div class="hdr__in">
    <a class="hdr__brand" href={href(lang, "/")} aria-label="SpaceHub franchise">
      <img src="/assets/figma/logo-icon.svg" width="36" height="32" alt="" />
      <img src="/assets/figma/logo-wordmark.svg" width="97" height="20" alt="SpaceHub" />
      <span class="hdr__sep" aria-hidden="true"></span>
      <span class="hdr__sub">franchise</span>
    </a>
    <details class="lng" data-lng>
      <summary aria-label="Language">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9s-1.3 6.4-3.8 9c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z" /></svg>
        {LANG_LABEL[lang]}
        <svg class="lng__car" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
      </summary>
      <ul>{LANGS.map((l) => <li><a href={href(l, "/")} hreflang={l} lang={l} aria-current={l === lang ? "true" : undefined} data-lang={l}>{LANG_NAME[l]}</a></li>)}</ul>
    </details>
    {cta && <nav class="hdr__cta" data-hdr-cta>
      <button type="button" class="btn btn--sm btn--dark" data-open-lead data-ev="get_in_touch_clicked" data-loc="header">{t("Get in touch")}</button>
      <a class="btn btn--sm btn--light" href={m.url} target="_blank" rel="noopener"
         data-ev="franchise_messenger_clicked" data-messenger={m.id} data-loc="header">
        <img src={m.icon} width="20" height="20" alt="" />{m.name}
      </a>
    </nav>}
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 20; padding: 0 40px; background: rgba(255,255,255,.86); backdrop-filter: blur(22px); }
  .hdr__in { max-width: 1360px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 8px 32px; }
  .hdr__brand { display: flex; align-items: center; gap: 8px; }
  .hdr__sep { width: 1.5px; height: 20px; background: var(--gray-300); margin: 0 8px; }
  .hdr__sub { font-weight: 600; font-size: 18px; line-height: 26px; color: var(--gray-600); }
  /* выбор языка (CMO 24.11.2026): выпадающий список; на первом экране – в правом углу, когда появляются кнопки, сдвигается влево */
  .lng { position: relative; margin-inline-start: auto; }
  .lng summary { display: flex; align-items: center; gap: 6px; height: 36px; padding: 0 10px 0 12px; border-radius: 99px; cursor: pointer; list-style: none;
                 font-weight: 600; font-size: 14px; color: var(--gray-700); transition: background .2s; }
  .lng summary::-webkit-details-marker { display: none; }
  .lng summary:hover, .lng[open] summary { background: var(--gray-100); }
  .lng svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; }
  .lng .lng__car { width: 14px; height: 14px; stroke-width: 2; transition: transform .2s; }
  .lng[open] .lng__car { transform: rotate(180deg); }
  .lng ul { position: absolute; top: calc(100% + 6px); inset-inline-end: 0; min-width: 160px; padding: 6px; margin: 0; list-style: none;
            background: var(--white); border-radius: 14px; box-shadow: 0 10px 30px rgba(0,0,0,.12), 0 0 0 1px rgba(0,0,0,.04); }
  .lng ul a { display: block; padding: 9px 12px; border-radius: 9px; font-weight: 500; font-size: 15px; color: var(--gray-800); }
  .lng ul a:hover { background: var(--gray-100); }
  .lng ul a[aria-current] { font-weight: 700; color: var(--brand); }
  .hdr__cta { display: flex; gap: 8px; align-items: center; padding-inline-start: 12px; max-width: 420px; white-space: nowrap;
              transition: max-width .4s ease, padding-inline-start .4s ease, opacity .3s .1s, transform .3s .1s; }
  :global(html.hero-on) .hdr__cta { max-width: 0; padding-inline-start: 0; overflow: hidden; opacity: 0; transform: translateY(-6px); pointer-events: none;
              transition: max-width .4s ease .1s, padding-inline-start .4s ease .1s, opacity .2s, transform .2s; }
  @media (prefers-reduced-motion: reduce) { .hdr__cta, :global(html.hero-on) .hdr__cta { transition: none; } }
  @media (max-width: 900px) {
    .hdr { padding: 0 8px; }
    .hdr__in { padding: 8px; }
    .hdr__sub, .hdr__sep { display: none; }
    .hdr__cta .btn--dark { display: none; }
  }
</style>

<script>
  // список языков закрывается по клику вне его и по Esc
  const d = document.querySelector<HTMLDetailsElement>("[data-lng]");
  if (d) {
    document.addEventListener("click", (e) => { if (d.open && !d.contains(e.target as Node)) d.open = false; });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape") d.open = false; });
  }
</script>


