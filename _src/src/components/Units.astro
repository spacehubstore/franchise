---
// Переключатель м² / sq ft (lib/units.ts). Состояние общее на весь лендинг.
const { label = "Area units" } = Astro.props;
---
<span class="units" data-units role="group" aria-label={label}>
  <button type="button" data-u="m2" class="on">m²</button><button type="button" data-u="ft">sq ft</button>
</span>
