---
// Первый экран (Figma 1531:5963), раскладка в две колонки (CMO 22.11.2026: фото кейса не сжимать по высоте, кейс читается
// целиком в первом экране). Слева – оффер, переключатель городов и доход до/после за всё помещение; справа – высокое фото
// со слайдером «до/после». На мобильном – одна колонка, фото 4:5.
import { CITIES, CONTACTS } from "../data/site";
const first = CITIES[0];
---
<section class="hero" data-cases data-cities={JSON.stringify(CITIES)}>
  <div class="hero__in wrap">
    <div class="hero__txt">
      <h1 class="hero__h">Turn your space into a self&#8209;storage business</h1>
      <p class="hero__lead">We design, equip, open and run the facility</p>
      <div class="hero__btns">
        <a class="btn btn--dark" href="#check" data-ev="check_your_space_clicked" data-loc="hero">Check your space</a>
        <a class="btn btn--light" href={CONTACTS.whatsapp.url} target="_blank" rel="noopener"
           data-ev="franchise_messenger_clicked" data-messenger="whatsapp" data-loc="hero">
          <img src="/assets/figma/whatsapp-24.svg" width="24" height="24" alt="" />WhatsApp
        </a>
      </div>

      <div class="case">
        <div class="tabs" role="tablist" aria-label="Cases by city">
          {CITIES.map((c, i) => (
            <button type="button" class={`tab ${i === 0 ? "tab--on" : ""}`} role="tab" aria-selected={i === 0 ? "true" : "false"} data-city={c.id}>
              <b>{c.name}</b><span>{c.region}</span>
            </button>
          ))}
        </div>
        <p class="case__space" data-v="space">{first.space}</p>
        <div class="case__nums">
          <div class="num num--before"><small>Leased whole</small><b data-v="before">{first.before}</b><span>a month</span></div>
          <svg class="case__arrow" viewBox="0 0 48 24" aria-hidden="true"><path d="M2 12h40m-8-8 8 8-8 8" /></svg>
          <div class="num num--after"><small>Self-storage</small><b data-v="after">{first.after}</b><span>a month</span></div>
        </div>
        <p class="case__note" data-v="note">{first.note}</p>
      </div>
    </div>

    <div class="ba" data-ba>
      <div class="ba__img" data-img="before" style={`background-image:url(${first.photos.before})`}></div>
      <div class="ba__img" data-img="after" style={`background-image:url(${first.photos.after})`} data-ba-after></div>
      <span class="ba__tag ba__tag--b">Before</span>
      <span class="ba__tag ba__tag--a">After</span>
      <div class="ba__handle" data-ba-handle aria-hidden="true"><span><svg viewBox="0 0 24 24"><path d="M9 6 3 12l6 6M15 6l6 6-6 6" /></svg></span></div>
      <input class="ba__range" type="range" min="0" max="100" value="50" aria-label="Before and after" data-ba-range />
    </div>
  </div>
</section>

<script>
  const box = document.querySelector<HTMLElement>("[data-cases]")!;
  const cities = JSON.parse(box.dataset.cities!);
  const range = box.querySelector<HTMLInputElement>("[data-ba-range]")!;
  const after = box.querySelector<HTMLElement>("[data-ba-after]")!;
  const handle = box.querySelector<HTMLElement>("[data-ba-handle]")!;
  const set = (v: number) => { after.style.clipPath = `inset(0 0 0 ${v}%)`; handle.style.left = `${v}%`; };
  range.addEventListener("input", () => set(+range.value));
  box.querySelectorAll<HTMLButtonElement>("[data-city]").forEach((t) => t.addEventListener("click", () => {
    const c = cities.find((x: any) => x.id === t.dataset.city);
    box.querySelectorAll("[data-city]").forEach((x) => { x.classList.toggle("tab--on", x === t); x.setAttribute("aria-selected", String(x === t)); });
    box.querySelectorAll<HTMLElement>("[data-img]").forEach((e) => {
      e.classList.add("is-swap");
      setTimeout(() => { e.style.backgroundImage = `url(${c.photos[e.dataset.img!]})`; e.classList.remove("is-swap"); }, 200);
    });
    (["before", "after", "space", "note"] as const).forEach((k) => (box.querySelector(`[data-v=${k}]`)!.textContent = c[k]));
    const nums = box.querySelector(".case__nums")!; nums.classList.remove("is-pop"); void (nums as HTMLElement).offsetWidth; nums.classList.add("is-pop");
    (window as any).dataLayer?.push({ event: "hero_case_switched", case_city: c.id });
  }));
  // подсказка, что слайдер двигается: короткий проход ручки при первом показе
  const hint = () => { let t = 0; const id = setInterval(() => { t += 1; set(50 + Math.sin(t / 6) * 14 * Math.max(0, 1 - t / 45)); if (t > 45) { clearInterval(id); set(50); } }, 30); };
  setTimeout(hint, 700);
  set(50);
</script>

<style>
  .hero { padding-block: 24px 72px; }
  .hero__in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: 56px; align-items: center; max-width: 1440px; }
  .hero__txt { display: flex; flex-direction: column; gap: 22px; }
  .hero__h { font-weight: 700; font-size: clamp(44px, 4.3vw, 64px); line-height: 1.06; letter-spacing: -1.9px; text-wrap: balance; }
  .hero__lead { font-weight: 500; font-size: 20px; line-height: 28px; color: var(--gray-600); }
  .hero__btns { display: flex; gap: 12px; }

  .case { margin-top: 18px; padding-top: 24px; border-top: 1px solid var(--gray-200); display: flex; flex-direction: column; gap: 14px; }
  .tabs { display: flex; gap: 6px; padding: 4px; background: var(--gray-100); border-radius: 100px; width: fit-content; }
  .tab { display: flex; flex-direction: column; align-items: flex-start; padding: 6px 18px; border-radius: 100px; text-align: left; transition: background .2s, box-shadow .2s; }
  .tab b { font-weight: 700; font-size: 16px; line-height: 20px; color: var(--gray-500); }
  .tab span { font-size: 12px; line-height: 16px; color: var(--gray-400); }
  .tab--on { background: var(--white); box-shadow: 0 2px 8px rgba(0,0,0,.08); }
  .tab--on b { color: var(--brand); }
  .case__space { font-weight: 600; font-size: 16px; color: var(--gray-600); }
  .case__nums { display: flex; align-items: center; gap: 14px; }
  .num { display: flex; flex-direction: column; padding: 14px 20px; border-radius: 20px; min-width: 0; }
  .num small { font-weight: 500; font-size: 13px; line-height: 18px; }
  .num b { font-weight: 700; font-size: clamp(30px, 2.8vw, 42px); line-height: 1.05; letter-spacing: -1px; white-space: nowrap; }
  .num span { font-size: 14px; line-height: 18px; }
  .num--before { background: var(--gray-100); color: var(--gray-900); }
  .num--before small, .num--before span { color: var(--gray-500); }
  .num--after { background: var(--brand); color: var(--white); box-shadow: 0 16px 36px rgba(255,79,0,.28); }
  .case__arrow { width: 40px; flex: none; fill: none; stroke: var(--gray-400); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .is-pop .num { animation: pop .45s cubic-bezier(.2,1.4,.4,1); }
  .is-pop .num--after { animation-delay: .08s; }
  @keyframes pop { from { transform: scale(.9); opacity: .4; } }
  .case__note { font-size: 13px; line-height: 18px; color: var(--gray-400); }

  .ba { position: relative; height: clamp(480px, calc(100svh - var(--hdr-h) - 72px), 760px); border-radius: 28px; overflow: hidden; background: var(--gray-100); }
  .ba__img { position: absolute; inset: 0; background-size: cover; background-position: center; transition: opacity .2s; }
  .ba__img.is-swap { opacity: .2; }
  .ba__tag { position: absolute; top: 18px; padding: 6px 14px; border-radius: 100px; font-weight: 600; font-size: 14px; pointer-events: none; z-index: 1; }
  .ba__tag--b { left: 18px; background: rgba(255,255,255,.92); color: var(--gray-900); }
  .ba__tag--a { right: 18px; background: var(--brand); color: var(--white); }
  .ba__handle { position: absolute; top: 0; bottom: 0; width: 3px; margin-left: -1.5px; background: var(--white); pointer-events: none; box-shadow: 0 0 12px rgba(0,0,0,.2); }
  .ba__handle span { position: absolute; top: 50%; left: 50%; width: 44px; height: 44px; margin: -22px 0 0 -22px; border-radius: 50%; background: var(--white); box-shadow: 0 4px 14px rgba(0,0,0,.2); display: grid; place-items: center; }
  .ba__handle svg { width: 22px; fill: none; stroke: var(--gray-900); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .ba__range { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: ew-resize; margin: 0; }

  @media (max-width: 1000px) {
    .hero { padding-block: 16px 56px; }
    .hero__in { grid-template-columns: 1fr; gap: 20px; }
    .hero__txt { display: contents; }
    .hero__h { font-size: 36px; letter-spacing: -1px; order: 1; }
    .hero__lead { font-size: 16px; line-height: 22px; order: 2; margin-top: -8px; }
    .hero__btns { order: 3; }
    .hero__btns .btn { flex: 1; min-width: 0; }
    .case { order: 4; margin-top: 0; padding-top: 0; border-top: 0; }
    .ba { order: 5; height: auto; aspect-ratio: 4 / 5; max-height: 68svh; max-width: 100%; }
    .tabs { width: 100%; }
    .tab { flex: 1; padding: 6px 10px; }
    .num { padding: 12px 14px; flex: 1; }
    .case__arrow { width: 24px; }
  }
</style>
