---
// Первый экран (Figma 1531:5963), две колонки. Всё, что относится к помещению, собрано на фото (CMO 22.11.2026):
// переключатель городов над фото, доход «до» и «после» – карточки на своих половинах слайдера, город и площадь – подпись
// под фото. Слева – оффер, кнопки и короткие факты. На мобильном – одна колонка, фото 4:5.
import { CITIES, CONTACTS } from "../data/site";
const first = CITIES[0];
const facts = ["Free assessment of your space in 48 hours", "8–11 weeks from signing to opening", "From a small unit to a whole building"];
---
<section class="hero" data-cases data-cities={JSON.stringify(CITIES)}>
  <div class="hero__in wrap">
    <div class="hero__txt">
      <h1 class="hero__h">Turn your space into a self&#8209;storage business</h1>
      <p class="hero__lead">We design, equip, open and run the facility</p>
      <div class="hero__btns">
        <button type="button" class="btn btn--dark" data-open-lead data-ev="get_in_touch_clicked" data-loc="hero">Get in touch</button>
        <a class="btn btn--light" href={CONTACTS.whatsapp.url} target="_blank" rel="noopener"
           data-ev="franchise_messenger_clicked" data-messenger="whatsapp" data-loc="hero">
          <img src="/assets/figma/whatsapp-24.svg" width="24" height="24" alt="" />WhatsApp
        </a>
      </div>
      <ul class="facts">{facts.map((f) => <li>{f}</li>)}</ul>
    </div>

    <div class="case">
      <div class="tabs" role="tablist" aria-label="Cases by city">
        {CITIES.map((c, i) => (
          <button type="button" class={`tab ${i === 0 ? "tab--on" : ""}`} role="tab" aria-selected={i === 0 ? "true" : "false"} data-city={c.id}>
            <img src="/assets/figma/pin-active.svg" width="18" height="18" alt="" />{c.name}
          </button>
        ))}
      </div>

      <div class="ba" data-ba>
        <div class="ba__img" data-img="before" style={`background-image:url(${first.photos.before})`}></div>
        <div class="ba__img" data-img="after" style={`background-image:url(${first.photos.after})`} data-ba-after></div>
        <div class="ba__handle" data-ba-handle aria-hidden="true"><span><svg viewBox="0 0 24 24"><path d="M9 6 3 12l6 6M15 6l6 6-6 6" /></svg></span></div>
        <input class="ba__range" type="range" min="0" max="100" value="50" aria-label="Before and after" data-ba-range />
        <div class="money money--b"><small>Before · leased whole</small><b data-v="before">{first.before}</b><span>a month</span></div>
        <div class="money money--a"><small>After · self-storage</small><b data-v="after">{first.after}</b><span>a month</span></div>
      </div>

      <p class="case__cap"><b><span data-v="name">{first.name}</span> · <span data-v="space">{first.space}</span></b><span data-v="note">{first.note}</span></p>
    </div>
  </div>
</section>

<script>
  const box = document.querySelector<HTMLElement>("[data-cases]")!;
  const cities = JSON.parse(box.dataset.cities!);
  const range = box.querySelector<HTMLInputElement>("[data-ba-range]")!;
  const after = box.querySelector<HTMLElement>("[data-ba-after]")!;
  const handle = box.querySelector<HTMLElement>("[data-ba-handle]")!;
  const set = (v: number) => { after.style.clipPath = `inset(0 0 0 ${v}%)`; handle.style.left = `${v}%`; };
  range.addEventListener("input", () => set(+range.value));
  box.querySelectorAll<HTMLButtonElement>("[data-city]").forEach((t) => t.addEventListener("click", () => {
    const c = cities.find((x: any) => x.id === t.dataset.city);
    box.querySelectorAll("[data-city]").forEach((x) => { x.classList.toggle("tab--on", x === t); x.setAttribute("aria-selected", String(x === t)); });
    box.querySelectorAll<HTMLElement>("[data-img]").forEach((e) => {
      e.classList.add("is-swap");
      setTimeout(() => { e.style.backgroundImage = `url(${c.photos[e.dataset.img!]})`; e.classList.remove("is-swap"); }, 200);
    });
    (["before", "after", "name", "space", "note"] as const).forEach((k) => (box.querySelector(`[data-v=${k}]`)!.textContent = c[k]));
    const ba = box.querySelector<HTMLElement>(".ba")!; ba.classList.remove("is-pop"); void ba.offsetWidth; ba.classList.add("is-pop");
    (window as any).dataLayer?.push({ event: "hero_case_switched", case_city: c.id });
  }));
  // подсказка, что слайдер двигается: короткий проход ручки при первом показе
  const hint = () => { let t = 0; const id = setInterval(() => { t += 1; set(50 + Math.sin(t / 6) * 14 * Math.max(0, 1 - t / 45)); if (t > 45) { clearInterval(id); set(50); } }, 30); };
  setTimeout(hint, 700);
  set(50);
</script>

<style>
  .hero { padding-block: 20px 72px; }
  .hero__in { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 56px; align-items: center; max-width: 1440px; }
  .hero__txt { display: flex; flex-direction: column; gap: 22px; }
  .hero__h { font-weight: 700; font-size: clamp(44px, 4.3vw, 64px); line-height: 1.06; letter-spacing: -1.9px; text-wrap: balance; }
  .hero__lead { font-weight: 500; font-size: 20px; line-height: 28px; color: var(--gray-600); }
  .hero__btns { display: flex; gap: 12px; }
  .facts { list-style: none; display: flex; flex-direction: column; gap: 10px; margin-top: 14px; padding-top: 22px; border-top: 1px solid var(--gray-200); }
  .facts li { display: flex; gap: 10px; align-items: center; font-weight: 500; font-size: 16px; color: var(--gray-600); }
  .facts li::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--brand); flex: none; }

  .case { display: flex; flex-direction: column; gap: 12px; min-width: 0; }
  .tabs { display: flex; gap: 6px; padding: 4px; background: var(--gray-100); border-radius: 100px; width: fit-content; }
  .tab { display: inline-flex; align-items: center; gap: 6px; height: 38px; padding: 0 16px 0 12px; border-radius: 100px; font-weight: 600; font-size: 15px; color: var(--gray-500); transition: background .2s, box-shadow .2s, color .2s; }
  .tab img { width: 18px; opacity: .35; filter: grayscale(1); transition: .2s; }
  .tab--on { background: var(--white); color: var(--gray-900); box-shadow: 0 2px 8px rgba(0,0,0,.08); }
  .tab--on img { opacity: 1; filter: none; }

  /* кейс ниже (CMO 23.11.2026): меньше потолка, высота ближе к левой колонке; кадр смещён к полу */
  .ba { position: relative; height: clamp(380px, calc(100svh - var(--hdr-h) - 330px), 540px); border-radius: 28px; overflow: hidden; background: var(--gray-100); }
  .ba__img { position: absolute; inset: 0; background-size: cover; background-position: center 72%; transition: opacity .2s; }
  .ba__img.is-swap { opacity: .2; }
  .ba__handle { position: absolute; top: 0; bottom: 0; width: 3px; margin-left: -1.5px; background: var(--white); pointer-events: none; box-shadow: 0 0 12px rgba(0,0,0,.2); z-index: 1; }
  .ba__handle span { position: absolute; top: 50%; left: 50%; width: 44px; height: 44px; margin: -22px 0 0 -22px; border-radius: 50%; background: var(--white); box-shadow: 0 4px 14px rgba(0,0,0,.2); display: grid; place-items: center; }
  .ba__handle svg { width: 22px; fill: none; stroke: var(--gray-900); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .ba__range { position: absolute; inset: 0; width: 100%; height: 100%; opacity: 0; cursor: ew-resize; margin: 0; z-index: 2; }

  /* доход на своих половинах фото */
  .money { position: absolute; bottom: 20px; display: flex; flex-direction: column; padding: 14px 18px; border-radius: 18px; pointer-events: none; z-index: 1; max-width: 44%; }
  .money small { font-weight: 600; font-size: 13px; line-height: 18px; }
  .money b { font-weight: 700; font-size: clamp(28px, 2.6vw, 40px); line-height: 1.05; letter-spacing: -1px; white-space: nowrap; }
  .money span { font-size: 14px; line-height: 18px; }
  .money--b { left: 20px; background: rgba(255,255,255,.94); color: var(--gray-900); box-shadow: 0 10px 30px rgba(0,0,0,.15); }
  .money--b small, .money--b span { color: var(--gray-500); }
  .money--a { right: 20px; background: var(--brand); color: var(--white); box-shadow: 0 14px 34px rgba(255,79,0,.4); }
  .money--a small, .money--a span { color: rgba(255,255,255,.88); }
  .is-pop .money { animation: pop .45s cubic-bezier(.2,1.4,.4,1); }
  .is-pop .money--a { animation-delay: .08s; }
  @keyframes pop { from { transform: scale(.9); opacity: .4; } }

  .case__cap { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; font-size: 14px; line-height: 20px; color: var(--gray-400); }
  .case__cap b { font-weight: 600; font-size: 15px; color: var(--gray-900); }

  @media (max-width: 1000px) {
    .hero { padding-block: 16px 56px; }
    .hero__in { grid-template-columns: 1fr; gap: 24px; }
    .hero__h { font-size: 36px; letter-spacing: -1px; }
    .hero__lead { font-size: 16px; line-height: 22px; margin-top: -8px; }
    .hero__btns .btn { flex: 1; min-width: 0; }
    .facts { display: none; }
    .tabs { width: 100%; }
    .tab { flex: 1; justify-content: center; padding: 0 8px; font-size: 14px; }
    .ba { height: auto; aspect-ratio: 4 / 5; max-height: 72svh; }
    .money { bottom: 12px; padding: 10px 12px; border-radius: 14px; }
    .money--b { left: 12px; } .money--a { right: 12px; }
    .money small { font-size: 11px; line-height: 14px; }
    .money b { font-size: 24px; }
    .money span { font-size: 12px; }
  }
</style>
