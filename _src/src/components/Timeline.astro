---
// «From the first call to opening» (Figma 1933:1494). Этапы и сроки – макет v7: оценка 48 ч, исследование 2 недели,
// производство 5–7 недель, монтаж 3–4 недели, всего 10–13 недель. Иконки – в стиле иконок квиза из Figma
// (генерация, CMO 22.11.2026: недостающие иллюстрации делаем сами в похожем стиле).
const steps = [
  { t: "Free assessment", d: "We look at your space and tell you if it fits", w: "48 hours", icon: "tl-assessment" },
  { t: "Feasibility study", d: "Layout, location analysis, budget, forecast", w: "2 weeks", icon: "tl-study" },
  { t: "Agreement", d: "Franchise signed, equipment ordered, your project manager starts", icon: "tl-agreement" },
  { t: "Production", d: "Doors, partitions and locks made to your layout", w: "5–7 weeks", icon: "tl-production" },
  { t: "Delivery", d: "Equipment arrives on site", icon: "tl-delivery" },
  { t: "Installation", d: "Units assembled, locks and cameras connected", w: "3–4 weeks", icon: "tl-install" },
  { t: "Opening", d: "First customers rent units from the app", icon: "tl-opening" },
];
// полоса сроков: доли по середине диапазонов (2 / 6 / 3,5 недели)
const bars = [{ t: "Feasibility", w: "2 weeks", f: 2 }, { t: "Production and delivery", w: "5–7 weeks", f: 6 }, { t: "Installation", w: "3–4 weeks", f: 3.5 }];
---
<section class="tl" id="timeline" data-tl>
  <div class="tl__head wrap">
    <h2>From the first call to opening</h2>
    <p>10–13 weeks from the feasibility study to opening,<br />in markets where we already work</p>
  </div>
  <div class="tl__scroll">
    <ol class="tl__row">
      {steps.map((s, i) => (
        <li style={`--d:${i * 0.12}s`}>
          <img src={`/assets/tl/${s.icon}.webp`} width="96" height="96" alt="" loading="lazy" />
          <b>{s.t}</b>
          <p>{s.d}</p>
          <i class="tl__dot"></i>
          <small>{s.w ?? ""}</small>
        </li>
      ))}
    </ol>
  </div>
  <div class="gantt wrap">
    <div class="gantt__bar">
      {bars.map((b, i) => <div class="gantt__seg" style={`flex:${b.f};--d:${0.9 + i * 0.35}s`}><b>{b.w}</b><span>{b.t}</span></div>)}
    </div>
    <div class="gantt__total"><b>10–13 weeks</b> to opening</div>
  </div>
</section>

<script>
  const tl = document.querySelector<HTMLElement>("[data-tl]")!;
  new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { tl.classList.add("in"); o.disconnect(); } }, { threshold: .25 }).observe(tl);
</script>

<style>
  .tl { background: var(--gray-900); color: var(--white); padding-block: 112px 96px; display: flex; flex-direction: column; gap: 56px; overflow: hidden; }
  .tl__head { text-align: center; display: flex; flex-direction: column; gap: 20px; align-items: center; }
  .tl__head h2 { font-weight: 700; font-size: 48px; line-height: 54px; }
  .tl__head p { font-weight: 500; font-size: 20px; line-height: 28px; color: var(--gray-300); }
  .tl__scroll { overflow-x: auto; padding: 0 var(--gutter); scrollbar-width: none; }
  .tl__row { list-style: none; display: grid; grid-template-columns: repeat(7, minmax(170px, 1fr)); max-width: 1296px; margin: 0 auto; position: relative; }
  .tl__row::after { content: ""; position: absolute; left: 0; right: 0; bottom: 39px; height: 1px; background: var(--gray-700); transform-origin: left; transform: scaleX(0); transition: transform 1.4s ease-out .2s; }
  .tl.in .tl__row::after { transform: none; }
  .tl__row li { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 12px; padding: 0 10px; opacity: 0; transform: translateY(24px); transition: .6s cubic-bezier(.2,.8,.2,1) var(--d); }
  .tl.in .tl__row li { opacity: 1; transform: none; }
  .tl__row img { width: 88px; height: 88px; object-fit: contain; transition: transform .3s; }
  .tl__row li:hover img { transform: translateY(-4px) rotate(-3deg); }
  .tl__row b { font-weight: 700; font-size: 20px; line-height: 24px; letter-spacing: -0.4px; }
  .tl__row p { flex: 1; font-weight: 500; font-size: 15px; line-height: 22px; color: var(--gray-300); }
  .tl__dot { width: 11px; height: 11px; border-radius: 50%; background: var(--white); box-shadow: 0 0 0 5px var(--gray-900); position: relative; z-index: 1; margin-top: 8px; }
  .tl__row li:last-child .tl__dot { background: var(--brand); }
  .tl__row small { font-weight: 600; font-size: 15px; line-height: 22px; color: var(--brand); min-height: 22px; }

  .gantt { max-width: 1296px; margin: 0 auto; width: 100%; display: flex; align-items: center; gap: 24px; }
  .gantt__bar { flex: 1; display: flex; gap: 4px; height: 56px; }
  .gantt__seg { display: flex; flex-direction: column; justify-content: center; padding: 0 16px; border-radius: 12px; background: var(--gray-800); transform-origin: left; transform: scaleX(0); transition: transform .6s ease-out var(--d); overflow: hidden; white-space: nowrap; }
  .gantt__seg:last-child { background: var(--brand); }
  .tl.in .gantt__seg { transform: none; }
  .gantt__seg b { font-size: 15px; line-height: 20px; }
  .gantt__seg span { font-size: 12px; line-height: 16px; color: var(--gray-400); }
  .gantt__seg:last-child span { color: rgba(255,255,255,.8); }
  .gantt__total { font-size: 15px; color: var(--gray-300); white-space: nowrap; }
  .gantt__total b { display: block; font-size: 28px; line-height: 32px; color: var(--white); }

  @media (max-width: 900px) {
    .tl { padding-block: 64px; gap: 32px; }
    .tl__head h2 { font-size: 32px; line-height: 38px; }
    .tl__head p { font-size: 17px; line-height: 24px; }
    .tl__row { grid-template-columns: repeat(7, 190px); }
    .gantt { flex-direction: column; align-items: stretch; gap: 12px; }
    .gantt__seg { padding: 0 10px; }
    .gantt__seg span { display: none; }
    .gantt__total { text-align: center; }
  }
</style>
