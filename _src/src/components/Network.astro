---
// «Think global, act local» (CMO 24.11.2026): масштаб SpaceHub без цифр сети. Полушарие из точек под углом, из-за горизонта
// встаёт надпись SpaceHub, подсвеченная из-за горизонта; на шаре пины стран (в точке города склада) и дуги от ОАЭ.
// Правки CMO 24.11.2026: без ленты фото, подписи – страны, без свечения за надписью (стык с тёмным блоком этапов); буквы оранжевые.
// Шар и координаты пинов – scripts/gen_globe.py (суша Natural Earth 1:50m, ортографическая проекция) → растр assets/net/globe-*.webp
// и data/globe.json. Слоган – рабочий, CMO заменит позже (общеизвестная фраза, не наш товарный знак).
// Точки – города складов по сайту на 24.11.2026 (Дубай, Бангкок, Стамбул, Таллин, Любляна); Словения – «скоро» (CMO 24.11.2026).
import G from "../data/globe.json";
import { langOf, useT } from "../i18n";
const lang = langOf(Astro.url.pathname);
const t = useT(lang);
// Площадь – полезная площадь действующих складов страны (CRM SpaceHub, raw_crm_storages.total_usable_area, без тестовых строк,
// 24.11.2026): ОАЭ 11 складов 5 761 м², Таиланд 3 – 1 286, Эстония 2 – 449, Турция 1 – 244; Словения 77 м² неактивна → «soon».
// На сайте – вниз до десятков, чтобы цифра не устаревала вверх; при открытии новых складов обновить.
const META: Record<string, { label: string; side: "l" | "r"; hub?: boolean; soon?: boolean; m2?: number }> = {
  Tallinn: { label: "Estonia", side: "r", m2: 440 }, Ljubljana: { label: "Slovenia", side: "l", soon: true }, Istanbul: { label: "Türkiye", side: "r", m2: 240 },
  Dubai: { label: "UAE", side: "r", hub: true, m2: 5760 }, Bangkok: { label: "Thailand", side: "l", m2: 1280 },
};
const fmt = (n: number) => n.toLocaleString("en-US");
const order = ["Dubai", "Istanbul", "Tallinn", "Ljubljana", "Bangkok"];
const pins = G.pins.map((p) => ({ ...p, ...META[p.city], d: 1500 + order.indexOf(p.city) * 160 }));
const arcs = G.arcs.map((a) => ({ ...a, d0: 1700 + order.indexOf(a.to) * 160 }));
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
---
<section class="net" id="network" aria-labelledby="net-h">
  <h2 id="net-h" class="vh">{t("SpaceHub in Europe, the Middle East and Asia")}</h2>
  <div class="stage rv" style={`--top:${pct(G.top, G.h)}; --gl:${pct(G.cx - G.r, G.w)}; --gw:${pct(2 * G.r, G.w)}`}>
    <div class="sun" aria-hidden="true">
      <span class="sun__tag">{t("Think global, act local")}</span>
      <span class="sun__word">SpaceHub</span>
    </div>
    <div class="rim" aria-hidden="true"></div>
    <img class="globe" src="/assets/net/globe-1440.webp" srcset="/assets/net/globe-1440.webp 1440w, /assets/net/globe-2880.webp 2880w" sizes="(max-width: 900px) 115vw, min(100vw, 1440px)" width={G.w} height={G.h} alt="" loading="lazy" decoding="async" />
    <svg class="arcs" viewBox={`0 0 ${G.w} ${G.h}`} aria-hidden="true">
      {arcs.map((a) => <path d={a.d} pathLength="1" style={`--d:${a.d0}ms`} />)}
    </svg>
    {pins.map((p) => (
      <div class={`pin pin--${p.side} pin--${p.city.toLowerCase()}${p.hub ? " pin--hub" : ""}${p.soon ? " pin--soon" : ""}`}
           style={`left:${p.x}%; top:${p.y}%; --d:${p.d}ms`}>
        <i></i>
        <span>{t(p.label)}{p.soon && <em>{t("soon")}</em>}{p.m2 && <b class="m2"><span data-to={p.m2} style={`--d:${p.d}ms`}>{fmt(p.m2)}</span> m²</b>}</span>
      </div>
    ))}
  </div>
</section>

<script>
  // счёт м² от нуля, когда пин появился; без JS и при «уменьшить движение» – сразу итог
  const box = document.querySelector<HTMLElement>(".net .stage");
  if (box) new IntersectionObserver(([e]) => box.classList.toggle("live", e.isIntersecting)).observe(box);
  const nums = [...document.querySelectorAll<HTMLElement>(".net [data-to]")];
  if (box && nums.length && !matchMedia("(prefers-reduced-motion: reduce)").matches) {
    const f = (n: number) => n.toLocaleString("en-US");
    nums.forEach((el) => (el.textContent = "0"));
    new IntersectionObserver(([e], o) => {
      if (!e.isIntersecting) return; o.disconnect();
      nums.forEach((el) => {
        const to = +el.dataset.to!, delay = parseInt(getComputedStyle(el).getPropertyValue("--d")) + 250, dur = 1400;
        setTimeout(() => {
          const t0 = performance.now();
          const step = (t: number) => { const k = Math.min(1, (t - t0) / dur); el.textContent = f(Math.round(to * (1 - Math.pow(1 - k, 3)) / 10) * 10); if (k < 1) requestAnimationFrame(step); };
          requestAnimationFrame(step);
        }, delay);
      });
    }, { threshold: .15, rootMargin: "0px 0px -8% 0px" }).observe(box);
  }
</script>

<style>
  .net { background: var(--gray-900); color: var(--white); padding-block: 0 72px; overflow: hidden; display: flex; flex-direction: column; gap: 8px; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* кадр 1440 × 700: шар ниже кадра, видна верхняя часть; всё внутри – в долях кадра */
  .stage { position: relative; width: 100%; max-width: 1440px; margin: 0 auto; aspect-ratio: 1440 / 700; direction: ltr; }
  .sun { position: absolute; left: 0; right: 0; top: 0; height: var(--top); display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
  .sun__tag { position: relative; font-weight: 700; font-size: clamp(12px, 1.25vw, 18px); letter-spacing: .22em; text-transform: uppercase; color: #ffb48f;
              opacity: 0; transform: translateY(10px); transition: opacity .8s ease-out .9s, transform .8s ease-out .9s; }
  .sun__word { position: relative; margin-bottom: -0.32em; font-weight: 800; font-size: clamp(64px, 15vw, 216px); line-height: 1; letter-spacing: -0.05em;
               background: linear-gradient(180deg, #ffd2bd 0%, #ff8a4c 45%, var(--brand) 80%); -webkit-background-clip: text; background-clip: text; color: transparent;
               transform: translateY(45%); opacity: .2; transition: transform 1.6s cubic-bezier(.2, .7, .2, 1), opacity 1.2s; }
  .rim { position: absolute; left: var(--gl); width: var(--gw); top: var(--top); aspect-ratio: 1; border-radius: 50%;
         box-shadow: 0 -1.5px 0 rgba(255, 140, 90, .5), 0 -14px 50px rgba(255, 79, 0, .16); pointer-events: none; }
  .globe { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* шар уходит в фон снизу, без резкого среза перед лентой фото */
  .stage::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 12%; background: linear-gradient(transparent, var(--gray-900)); pointer-events: none; }
  .rv.in .sun__tag { opacity: 1; transform: none; }
  .rv.in .sun__word { transform: none; opacity: 1; }

  .arcs { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .arcs path { fill: none; stroke: var(--brand); stroke-width: 2; stroke-linecap: round; stroke-opacity: .8;
               stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.1s ease-in-out; transition-delay: var(--d); }
  .rv.in .arcs path { stroke-dashoffset: 0; }

  .pin { position: absolute; width: 0; height: 0; z-index: 2; }   /* над нижним градиентом шара */
  .pin i { position: absolute; left: -7px; top: -7px; width: 14px; height: 14px; border-radius: 50%; background: var(--brand);
           box-shadow: 0 0 0 6px rgba(255, 79, 0, .22); transform: scale(0); transition: transform .45s cubic-bezier(.3, 1.6, .5, 1); transition-delay: var(--d); }
  .pin--hub i { left: -10px; top: -10px; width: 20px; height: 20px; box-shadow: 0 0 0 10px rgba(255, 79, 0, .22); }
  .pin--hub i::after { content: ""; position: absolute; inset: -12px; border-radius: 50%; border: 2px solid var(--brand); opacity: 0; animation: ping 2.4s ease-out infinite paused; animation-delay: calc(var(--d) + .6s); }
  .stage.live .pin--hub i::after { animation-play-state: running; }   /* пульс только пока блок на экране */
  .pin--soon i { background: var(--gray-900); box-shadow: inset 0 0 0 3px var(--brand); }
  .pin span { position: absolute; top: -16px; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; padding: 5px 13px; border-radius: var(--pill);
              background: rgba(24, 24, 27, .86); border: 1px solid var(--gray-700); font-weight: 700; font-size: 15px; line-height: 20px;
              opacity: 0; transform: translateY(6px); transition: opacity .35s, transform .35s; transition-delay: calc(var(--d) + .15s); }
  .pin--hub span { border-color: rgba(255, 79, 0, .6); }
  .pin--r span { left: 20px; }
  .pin--l span { right: 20px; }
  .pin em { font-style: normal; font-weight: 600; color: var(--gray-400); }
  .pin .m2 { font-weight: 800; color: #ffb48f; font-variant-numeric: tabular-nums; }
  .pin .m2 span { position: static; display: inline; padding: 0; border: 0; background: none; opacity: 1; transform: none; font: inherit; color: inherit; }
  .rv.in .pin i { transform: scale(1); }
  .rv.in .pin span { opacity: 1; transform: none; }
  @keyframes ping { 0% { transform: scale(.6); opacity: .7; } 100% { transform: scale(1.8); opacity: 0; } }
  /* арабский: география не зеркалится – кадр всегда слева направо, справа налево только текст подписи; площадь – слева направо */
  :global([dir=rtl]) .pin span { direction: rtl; }
  .pin .m2 { direction: ltr; unicode-bidi: isolate; }


  @media (max-width: 900px) {
    .net { padding-block: 32px 48px; }
    /* на узком экране шар приближен: пустые края кадра срезаны, у подписей пяти стран больше места */
    .stage { width: 115%; max-width: none; margin-inline: -7.5%; }
    .pin span { top: -12px; padding: 2px 9px; font-size: 11px; line-height: 18px; }
    .pin i { left: -5px; top: -5px; width: 10px; height: 10px; box-shadow: 0 0 0 4px rgba(255, 79, 0, .22); }
    .pin--hub i { left: -7px; top: -7px; width: 14px; height: 14px; }
    .pin.pin--bangkok span { top: 2px; }   /* Таиланд ниже точки: иначе подпись заходит на плашку ОАЭ */
    .pin.pin--soon span { right: auto; left: 50%; top: -36px; transform: translateX(-50%); }   /* Словения: сбоку подпись уходит за край экрана – над точкой */
    .rv.in .pin.pin--soon span { transform: translateX(-50%); }
    .pin--r span { left: 14px; }
    .pin--l span { right: 14px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sun__tag, .sun__word, .arcs path, .pin i, .pin span { transition: none; }
    .pin--hub i::after { animation: none; }
  }
</style>
