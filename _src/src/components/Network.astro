---
// «Think global, act local» (CMO 24.11.2026): масштаб SpaceHub без цифр сети. Полушарие из точек под углом, из-за горизонта
// встаёт надпись SpaceHub, как солнце; на шаре пины городов и дуги от Дубая; ниже – фото складов со spacehubstore.com.
// Шар и координаты пинов – scripts/gen_globe.py (суша Natural Earth 1:50m, ортографическая проекция) → assets/net/globe.svg
// и data/globe.json. Слоган – рабочий, CMO заменит позже (общеизвестная фраза, не наш товарный знак).
// Города и районы – страницы складов сайта на 24.11.2026; Любляна – «скоро» (CMO 24.11.2026).
import G from "../data/globe.json";
import { langOf, useT } from "../i18n";
const lang = langOf(Astro.url.pathname);
const t = useT(lang);
const META: Record<string, { side: "l" | "r"; hub?: boolean; soon?: boolean; mob?: boolean }> = {
  Tallinn: { side: "r" }, Ljubljana: { side: "l", soon: true }, Istanbul: { side: "r" },
  Dubai: { side: "r", hub: true, mob: true }, Bangkok: { side: "l", mob: true },
};
const order = ["Dubai", "Istanbul", "Tallinn", "Ljubljana", "Bangkok"];
const pins = G.pins.map((p) => ({ ...p, ...META[p.city], d: 1500 + order.indexOf(p.city) * 160 }));
const arcs = G.arcs.map((a) => ({ ...a, d0: 1700 + order.indexOf(a.to) * 160 }));
const pct = (v: number, of: number) => `${((v / of) * 100).toFixed(3)}%`;
const cards = [
  { city: "Dubai", country: "UAE", img: "dubai", areas: "Al Quoz · Ras Al Khor · Al Karama · Al Garhoud · Deira · Umm Ramool" },
  { city: "Bangkok", country: "Thailand", img: "bangkok", areas: "Phra Khanong · Suvarnabhumi · Italthai Tower" },
  { city: "Istanbul", country: "Türkiye", img: "istanbul", areas: "Beylikdüzü" },
  { city: "Tallinn", country: "Estonia", img: "tallinn", areas: "Mustamäe · Lasnamäe" },
];
---
<section class="net" id="network" aria-labelledby="net-h">
  <h2 id="net-h" class="vh">{t("SpaceHub in Europe, the Middle East and Asia")}</h2>
  <div class="stage rv" style={`--top:${pct(G.top, G.h)}; --gl:${pct(G.cx - G.r, G.w)}; --gw:${pct(2 * G.r, G.w)}`}>
    <div class="sun" aria-hidden="true">
      <span class="sun__tag">{t("Think global, act local")}</span>
      <span class="sun__word">SpaceHub</span>
    </div>
    <div class="rim" aria-hidden="true"></div>
    <img class="globe" src="/assets/net/globe.svg" width={G.w} height={G.h} alt="" loading="lazy" />
    <svg class="arcs" viewBox={`0 0 ${G.w} ${G.h}`} aria-hidden="true">
      {arcs.map((a) => <path d={a.d} pathLength="1" style={`--d:${a.d0}ms`} />)}
    </svg>
    {pins.map((p) => (
      <div class={`pin pin--${p.side}${p.hub ? " pin--hub" : ""}${p.soon ? " pin--soon" : ""}${p.mob ? " pin--mob" : ""}`}
           style={`left:${p.x}%; top:${p.y}%; --d:${p.d}ms`}>
        <i></i>
        <span>{t(p.city)}{p.soon && <em>{t("soon")}</em>}</span>
      </div>
    ))}
  </div>
  <div class="strip wrap">
    {cards.map((c) => (
      <figure class="card">
        <img src={`/assets/net/${c.img}-640.webp`} srcset={`/assets/net/${c.img}-640.webp 640w, /assets/net/${c.img}-1024.webp 1024w`}
             sizes="(max-width: 900px) 72vw, 320px" width="640" height="480" alt={t(c.city)} loading="lazy" />
        <figcaption><b>{t(c.city)}</b><span>{t(c.country)}</span><small>{c.areas}</small></figcaption>
      </figure>
    ))}
  </div>
</section>

<style>
  .net { background: var(--gray-900); color: var(--white); padding-block: 40px 96px; overflow: hidden; display: flex; flex-direction: column; gap: 8px; }
  .vh { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  /* кадр 1440 × 780: шар ниже кадра, видна верхняя часть; всё внутри – в долях кадра */
  .stage { position: relative; width: 100%; max-width: 1440px; margin: 0 auto; aspect-ratio: 1440 / 780; }
  .sun { position: absolute; left: 0; right: 0; top: 0; height: var(--top); display: flex; flex-direction: column; align-items: center; justify-content: flex-end; }
  /* ореол «восхода»: широкое тёплое свечение над горизонтом */
  .sun::before { content: ""; position: absolute; left: 50%; bottom: -14%; width: 78%; aspect-ratio: 2.4; transform: translateX(-50%);
                 background: radial-gradient(closest-side, rgba(255, 79, 0, .55), rgba(255, 79, 0, .18) 45%, transparent 72%); filter: blur(6px);
                 opacity: 0; transition: opacity 1.6s ease-out .2s; }
  .sun__tag { position: relative; font-weight: 700; font-size: clamp(12px, 1.25vw, 18px); letter-spacing: .22em; text-transform: uppercase; color: #ffb48f;
              opacity: 0; transform: translateY(10px); transition: opacity .8s ease-out .9s, transform .8s ease-out .9s; }
  .sun__word { position: relative; margin-bottom: -0.32em; font-weight: 800; font-size: clamp(64px, 15vw, 216px); line-height: 1; letter-spacing: -0.05em;
               background: linear-gradient(180deg, #ffd2bd 0%, #ff8a4c 45%, var(--brand) 80%); -webkit-background-clip: text; background-clip: text; color: transparent;
               filter: drop-shadow(0 0 28px rgba(255, 79, 0, .45));
               transform: translateY(45%); opacity: .2; transition: transform 1.6s cubic-bezier(.2, .7, .2, 1), opacity 1.2s; }
  .rim { position: absolute; left: var(--gl); width: var(--gw); top: var(--top); aspect-ratio: 1; border-radius: 50%;
         box-shadow: 0 -2px 0 rgba(255, 140, 90, .55), 0 -18px 70px rgba(255, 79, 0, .28); pointer-events: none; }
  .globe { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* шар уходит в фон снизу, без резкого среза перед лентой фото */
  .stage::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 22%; background: linear-gradient(transparent, var(--gray-900)); pointer-events: none; }
  .rv.in .sun::before { opacity: 1; }
  .rv.in .sun__tag { opacity: 1; transform: none; }
  .rv.in .sun__word { transform: none; opacity: 1; }

  .arcs { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .arcs path { fill: none; stroke: var(--brand); stroke-width: 2; stroke-linecap: round; stroke-opacity: .8;
               stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.1s ease-in-out; transition-delay: var(--d); }
  .rv.in .arcs path { stroke-dashoffset: 0; }

  .pin { position: absolute; width: 0; height: 0; }
  .pin i { position: absolute; left: -7px; top: -7px; width: 14px; height: 14px; border-radius: 50%; background: var(--brand);
           box-shadow: 0 0 0 6px rgba(255, 79, 0, .22); transform: scale(0); transition: transform .45s cubic-bezier(.3, 1.6, .5, 1); transition-delay: var(--d); }
  .pin--hub i { left: -10px; top: -10px; width: 20px; height: 20px; box-shadow: 0 0 0 10px rgba(255, 79, 0, .22); }
  .pin--hub i::after { content: ""; position: absolute; inset: -12px; border-radius: 50%; border: 2px solid var(--brand); opacity: 0; animation: ping 2.4s ease-out infinite; animation-delay: calc(var(--d) + .6s); }
  .pin--soon i { background: var(--gray-900); box-shadow: inset 0 0 0 3px var(--brand); }
  .pin span { position: absolute; top: -16px; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; padding: 5px 13px; border-radius: var(--pill);
              background: rgba(24, 24, 27, .86); border: 1px solid var(--gray-700); backdrop-filter: blur(6px); font-weight: 700; font-size: 15px; line-height: 20px;
              opacity: 0; transform: translateY(6px); transition: opacity .35s, transform .35s; transition-delay: calc(var(--d) + .15s); }
  .pin--hub span { border-color: rgba(255, 79, 0, .6); }
  .pin--r span { left: 20px; }
  .pin--l span { right: 20px; }
  .pin em { font-style: normal; font-weight: 600; color: var(--gray-400); }
  .rv.in .pin i { transform: scale(1); }
  .rv.in .pin span { opacity: 1; transform: none; }
  @keyframes ping { 0% { transform: scale(.6); opacity: .7; } 100% { transform: scale(1.8); opacity: 0; } }
  :global([dir=rtl]) .pin--r span { left: auto; right: 20px; }
  :global([dir=rtl]) .pin--l span { right: auto; left: 20px; }

  /* фото складов: доказательство под эмоцией; на телефоне – лента с прокруткой */
  .strip { max-width: 1296px; width: 100%; margin: 0 auto; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 16px; }
  .card { display: flex; flex-direction: column; gap: 12px; }
  .card img { width: 100%; aspect-ratio: 4 / 3; height: auto; object-fit: cover; border-radius: var(--radius-l); background: var(--gray-800); }
  .card figcaption { display: grid; grid-template-columns: auto 1fr; column-gap: 8px; row-gap: 4px; align-items: baseline; padding-inline: 4px; }
  .card b { font-weight: 700; font-size: 18px; line-height: 24px; }
  .card span { font-weight: 600; font-size: 14px; color: var(--gray-400); }
  .card small { grid-column: 1 / -1; font-weight: 500; font-size: 13px; line-height: 19px; color: var(--gray-500); }

  @media (max-width: 900px) {
    .net { padding-block: 24px 64px; }
    .pin span { top: -12px; padding: 2px 9px; font-size: 11px; line-height: 18px; }
    .pin:not(.pin--mob) span { display: none; }
    .pin i { left: -5px; top: -5px; width: 10px; height: 10px; box-shadow: 0 0 0 4px rgba(255, 79, 0, .22); }
    .pin--hub i { left: -7px; top: -7px; width: 14px; height: 14px; }
    .pin--r span { left: 14px; }
    .pin--l span { right: 14px; }
    .strip { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scroll-padding-inline: 16px; gap: 12px; padding: 0 16px 4px; scrollbar-width: none; }
    .card { flex: 0 0 72%; scroll-snap-align: start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .sun::before, .sun__tag, .sun__word, .arcs path, .pin i, .pin span { transition: none; }
    .pin--hub i::after { animation: none; }
  }
</style>
