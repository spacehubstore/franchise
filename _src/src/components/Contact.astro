---
// «Let's discuss your project» (Figma 1448:2383) + что будет после заявки (сроки из макета v7: звонок в течение рабочего часа,
// оценка 48 ч, исследование 2 недели) и мессенджеры – блок был пустоватым (CMO 22.11.2026). Отправка – lib/lead.ts.
import { CONTACTS } from "../data/site";
const CODES = ["+66", "+971", "+966", "+63", "+372", "+90", "+7", "+44", "+1"];
const next = [
  { t: "We call you back", d: "Within 1 working hour" },
  { t: "Free assessment", d: "Whether your space fits, in 48 hours" },
  { t: "Feasibility study", d: "Layout, budget and income forecast for your address in 2 weeks" },
];
---
<section class="ct wrap" id="contact">
  <div class="ct__box">
    <div class="ct__left">
      <h2>Let’s discuss<br />your project</h2>
      <ol class="nx">
        {next.map((s, i) => <li class="rv" style={`--d:${i * 0.12}s`}><span>{i + 1}</span><div><b>{s.t}</b><p>{s.d}</p></div></li>)}
      </ol>
      <div class="who">
        <img src="/assets/alexey.webp" width="72" height="72" alt="Alexey Romanenkov" loading="lazy" />
        <div class="who__txt"><b>Alexey Romanenkov</b><span>Head of partnerships</span></div>
        <div class="who__msg">
          <a href={CONTACTS.whatsapp.url} target="_blank" rel="noopener" data-ev="franchise_messenger_clicked" data-messenger="whatsapp" data-loc="contact"><img src="/assets/figma/whatsapp-24.svg" width="20" height="20" alt="" />WhatsApp</a>
          <a href={CONTACTS.line.url} target="_blank" rel="noopener" data-ev="franchise_messenger_clicked" data-messenger="line" data-loc="contact"><i class="line-ic">LINE</i>LINE</a>
        </div>
      </div>
    </div>
    <form class="cf" data-cf novalidate>
      <h3>Get a free assessment</h3>
      <label class="cf__f"><span>Name</span><input name="name" autocomplete="name" placeholder="Your name" /></label>
      <label class="cf__f"><span>Email</span><input name="email" type="email" autocomplete="email" placeholder="Your email" /></label>
      <label class="cf__f"><span>City</span><input name="city" autocomplete="address-level2" placeholder="e.g. Bangkok" /></label>
      <div class="cf__f cf__ph">
        <span>Phone number</span>
        <select name="code" aria-label="Country code">{CODES.map((c) => <option>{c}</option>)}</select>
        <i></i>
        <input name="phone" type="tel" autocomplete="tel-national" placeholder="81 234 5678" />
      </div>
      <div class="cf__checks">
        <label><input type="checkbox" name="wa" checked /> Message me on WhatsApp</label>
        <label><input type="checkbox" name="agree" /> <span>I agree to the processing of my data under the <a href="https://spacehubstore.com/thailand/en/privacy" target="_blank" rel="noopener">privacy policy</a></span></label>
      </div>
      <button class="btn btn--or" type="submit">Send</button>
      <p class="cf__note">Free and with no obligation</p>
      <p class="cf__err" hidden data-cf-err>Please add your name, phone and consent</p>
      <div class="cf__ok" hidden data-cf-ok><b>Thank you</b><span>Alexey will contact you within 1 working hour</span></div>
    </form>
  </div>
</section>

<script>
  import { sendLead } from "../lib/lead";
  const form = document.querySelector<HTMLFormElement>("[data-cf]")!;
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const phone = `${f.get("code")} ${f.get("phone") || ""}`.trim();
    const err = form.querySelector<HTMLElement>("[data-cf-err]")!;
    if (!f.get("name") || !f.get("phone") || !f.get("agree")) { err.hidden = false; return; }
    err.hidden = true;
    const how = await sendLead({ form: "contact", name: f.get("name"), email: f.get("email"), city: f.get("city"), phone,
                                 messenger: f.get("wa") ? "whatsapp" : "call" },
                               `Franchise request. ${f.get("name")}, ${phone}, ${f.get("city") || ""}`);
    (window as any).dataLayer?.push({ event: "franchise_callback_form_sent", form_location: "contact", site_variant: location.pathname, delivery: how });
    form.querySelector<HTMLElement>("[data-cf-ok]")!.hidden = false;
  });
</script>

<style>
  .ct { padding-block: 24px 96px; }
  .ct__box { position: relative; overflow: hidden; max-width: 1296px; margin: 0 auto; background: var(--brand); border-radius: 32px; padding: 80px 96px; display: flex; justify-content: space-between; align-items: center; gap: 48px; }
  .ct__box::before { content: ""; position: absolute; right: -160px; top: -220px; width: 640px; height: 640px; border-radius: 50%; background: radial-gradient(closest-side, rgba(255,255,255,.28), rgba(255,255,255,0)); pointer-events: none; }
  .ct__left { position: relative; width: 500px; display: flex; flex-direction: column; gap: 32px; color: var(--white); }
  .ct__left h2 { font-weight: 700; font-size: 64px; line-height: 1.1; letter-spacing: -1.92px; }
  .nx { list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .nx li { display: flex; gap: 16px; align-items: center; background: rgba(255,255,255,.14); border: 1px solid rgba(255,255,255,.22); border-radius: 16px; padding: 14px 18px; backdrop-filter: blur(6px); }
  .nx li > span { flex: none; width: 36px; height: 36px; border-radius: 50%; background: var(--white); color: var(--brand); display: grid; place-items: center; font-weight: 700; }
  .nx b { font-size: 17px; line-height: 22px; }
  .nx p { font-size: 15px; line-height: 20px; opacity: .9; }
  .who { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
  .who > img { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; object-position: top; background: var(--white); border: 3px solid rgba(255,255,255,.6); }
  .who__txt b { display: block; font-size: 17px; line-height: 22px; }
  .who__txt span { font-size: 15px; opacity: .9; }
  .who__msg { display: flex; gap: 8px; margin-left: auto; }
  .who__msg a { display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 14px; border-radius: 100px; background: var(--white); color: var(--gray-900); font-weight: 600; font-size: 14px; transition: transform .2s; }
  .who__msg a:hover { transform: translateY(-2px); }
  .line-ic { font-style: normal; font-size: 7px; font-weight: 800; color: var(--white); background: #06c755; border-radius: 6px; width: 20px; height: 20px; display: grid; place-items: center; }

  .cf { position: relative; width: 480px; flex: none; background: var(--white); border-radius: 25px; padding: 36px 32px 28px; display: flex; flex-direction: column; gap: 22px; box-shadow: 0 30px 60px rgba(120,30,0,.25); }
  .cf h3 { font-weight: 700; font-size: 24px; line-height: 28px; }
  .cf__f { position: relative; display: flex; align-items: center; gap: 10px; height: 54px; border: 1px solid var(--gray-300); border-radius: 12px; padding: 0 16px; }
  .cf__f:focus-within { border-color: var(--gray-900); }
  .cf__f > span { position: absolute; left: 12px; top: -9px; padding: 0 4px; background: var(--white); font-weight: 500; font-size: 13px; line-height: 16px; color: var(--gray-500); }
  .cf__f input, .cf__f select { flex: 1; min-width: 0; border: 0; outline: 0; background: none; font: 500 15px/22px "Manrope", sans-serif; color: var(--gray-900); }
  .cf__f input::placeholder { color: var(--gray-400); }
  .cf__ph select { flex: none; }
  .cf__ph i { width: 1px; height: 22px; background: var(--gray-300); }
  .cf__checks { display: flex; flex-direction: column; gap: 10px; font-weight: 500; font-size: 15px; line-height: 22px; color: #333; }
  .cf__checks label { display: flex; gap: 12px; align-items: flex-start; }
  .cf__checks input { width: 20px; height: 20px; margin-top: 1px; accent-color: var(--brand); flex: none; }
  .cf__checks a { color: var(--gray-900); text-decoration: underline; }
  .cf .btn--or { width: 100%; }
  .cf__note { margin-top: -12px; text-align: center; font-size: 13px; color: var(--gray-500); }
  .cf__err { color: var(--brand); font-size: 14px; }
  .cf__ok { position: absolute; inset: 0; border-radius: 25px; background: var(--white); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; text-align: center; padding: 32px; animation: fade .4s; }
  .cf__ok[hidden] { display: none; }
  .cf__ok b { font-size: 28px; }
  .cf__ok span { color: var(--gray-600); }
  @keyframes fade { from { opacity: 0; } }

  @media (max-width: 1100px) {
    .ct__box { flex-direction: column; align-items: stretch; padding: 48px 24px; }
    .ct__left, .cf { width: 100%; }
  }
  @media (max-width: 900px) {
    .ct { padding-block: 8px 64px; }
    .ct__box { padding: 36px 16px 16px; border-radius: 24px; gap: 28px; }
    .ct__left { gap: 24px; }
    .ct__left h2 { font-size: 38px; letter-spacing: -1.1px; }
    .who__msg { margin-left: 0; width: 100%; }
    .who__msg a { flex: 1; justify-content: center; }
    .cf { padding: 28px 16px 20px; }
  }
</style>
