---
// Финальный блок заявки (Figma 1448:2383), переработан (CMO 23.11.2026): заголовок «Let’s discuss your project» (вернули), три шага «что дальше» убраны
// (повторяли таймлайн и блок исследования), кнопка «Get in touch» (подходит и тем, у кого нет помещения). Мессенджер – по языку страницы (тайская версия – LINE).
// Телефон: заголовок → форма → Алексей и мессенджеры. Отправка – lib/lead.ts.
import { langOf, useT, href, messenger, LANGS, LANG_LABEL } from "../i18n";
const lang = langOf(Astro.url.pathname);
const t = useT(lang);
const m = messenger(lang);
---
<section class="ct wrap" id="contact">
  <div class="ct__box">
    <div class="ct__head">
      <h2 set:html={t("Let’s discuss<br />your project")} />
      <p>{t("We reply within 1 working hour")}</p>
    </div>
    <div class="who">
      <span class="ava" data-ava><img class="ava__fig" src="/assets/alexey-rest.webp" data-end="/assets/alexey-end.webp" width="283" height="278" alt="Alexey Romanenkov" /><video class="ava__fig ava__vid" muted playsinline preload="none" width="283" height="278" aria-hidden="true" hidden></video></span>
      <div class="who__side">
        <div class="who__txt"><b>Alexey Romanenkov</b><span>{t("Head of partnerships")}</span></div>
        <div class="who__msg">
        <a href={m.url} target="_blank" rel="noopener" data-ev="franchise_messenger_clicked" data-messenger={m.id} data-loc="contact"><img src={m.icon} width="20" height="20" alt="" />{m.name}</a>
        </div>
      </div>
    </div>
    <form class="cf" data-cf novalidate>
      <label class="cf__f"><span>{t("Name")}</span><input name="name" autocomplete="name" placeholder={t("Your name")} /></label>
      <label class="cf__f"><span>{t("City")}</span><input name="city" autocomplete="address-level2" placeholder={t("e.g. Bangkok")} /></label>
      <div class="cf__f cf__ph">
        <span>{t("Phone number")}</span>
        <select name="code" aria-label={t("Country code")}></select>
        <i></i>
        <input name="phone" type="tel" autocomplete="tel-national" placeholder="81 234 5678" />
      </div>
      <div class="cf__checks">
        <label><input type="checkbox" name="agree" /> <span>{t("I agree to the processing of my data under the")} <a href={href(lang, "/privacy")} target="_blank">{t("privacy policy")}</a></span></label>
      </div>
      <button class="btn btn--or" type="submit">{t("Get in touch")}</button>
      <div class="cf__ok" hidden data-cf-ok><b>{t("Thank you")}</b><span>{t("Alexey will contact you within 1 working hour")}</span></div>
    </form>
  </div>
</section>

<script>
  import { sendLead } from "../lib/lead";
  import { prepare, ready } from "../lib/formsLazy";
  const form = document.querySelector<HTMLFormElement>("[data-cf]")!;
  prepare(form);
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const { ok, phone } = (await ready(form)).checkForm(form, "contact");
    if (!ok) return;
    const how = await sendLead({ form: "contact", name: f.get("name"), city: f.get("city"), phone },
                               `Franchise request. ${f.get("name")}, ${phone}, ${f.get("city") || ""}`);
    (window as any).dataLayer?.push({ event: "callback_form_sent", form_location: "partner", lead_form: "contact", site_variant: location.pathname, delivery: how });
    form.querySelector<HTMLElement>("[data-cf-ok]")!.hidden = false;
  });
  // Алексей показывает на мессенджер, когда блок контактов виден
  const who = document.querySelector<HTMLElement>("#contact .who");
  const fig = who?.querySelector<HTMLImageElement>("img.ava__fig"), vid = who?.querySelector<HTMLVideoElement>(".ava__vid");
  if (who && fig && vid) {
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const end = () => { fig.src = fig.dataset.end!; vid.hidden = true; fig.hidden = false; who.classList.add("go"); };
    // прозрачное видео: WebKit (Safari, все браузеры iPhone) – HEVC с альфой, остальные – WebM VP9 с альфой
    const ua = navigator.userAgent, webkit = /iPhone|iPad|iPod/.test(ua) || (/Safari/.test(ua) && !/Chrome|Chromium|Edg|OPR/.test(ua));
    let ready = false, armed = false;
    const play = () => {
      vid.hidden = false;
      vid.play().then(() => { fig.hidden = true; who.classList.add("go"); }).catch(end);
    };
    const load = () => {
      if (still) { end(); return; }
      vid.src = webkit ? "/assets/alexey-point.mp4" : "/assets/alexey-point.webm"; vid.preload = "auto";
      vid.addEventListener("canplaythrough", () => { ready = true; if (armed) play(); }, { once: true });
      vid.addEventListener("error", end, { once: true });
      vid.load();
    };
    if (!("IntersectionObserver" in window)) { end(); }
    else {
      // ролик подгружается на подходе к блоку; играет один раз, когда блок целиком на экране, и останавливается на жесте
      const near = new IntersectionObserver((es) => { if (es[0].isIntersecting) { near.disconnect(); load(); } }, { rootMargin: "600px" });
      const io = new IntersectionObserver((es) => { if (es[0].isIntersecting) { io.disconnect(); armed = true; if (still) end(); else if (ready) setTimeout(play, 250); else setTimeout(() => { if (!ready) end(); }, 6000); } }, { threshold: 0.9 });
      near.observe(who); io.observe(who);
    }
  }

</script>

<style>
  .ct { padding-block: 64px; }
  .ct__box { position: relative; overflow: hidden; max-width: 1296px; margin: 0 auto; background: var(--brand); border-radius: 32px; padding: 80px 96px; color: var(--white);
             display: grid; grid-template-columns: minmax(0, 1fr) 480px; grid-template-areas: "head form" "who form"; column-gap: 64px; row-gap: 40px; align-items: center; }
  .ct__box::before { content: ""; position: absolute; right: -160px; top: -220px; width: 640px; height: 640px; border-radius: 50%; background: radial-gradient(closest-side, rgba(255,255,255,.28), rgba(255,255,255,0)); pointer-events: none; }
  .ct__head { grid-area: head; align-self: end; position: relative; display: flex; flex-direction: column; gap: 20px; max-width: 540px; }
  .ct__head h2 { font-weight: 700; font-size: 60px; line-height: 1.08; letter-spacing: -1.8px; text-wrap: balance; }
  .ct__head p { font-weight: 500; font-size: 20px; line-height: 28px; opacity: .92; }
  /* Алексей – крупный круг, рядом имя, роль и мессенджеры */
  .who { grid-area: who; align-self: start; position: relative; display: flex; align-items: center; gap: 36px; }   /* место под кисть */
  .who__side { display: flex; flex-direction: column; gap: 12px; }
  /* Алексей (CMO 23.11.2026): живое движение – ролик Gemini Omni по его фото, фон вырезан. Внутри круга вся фигура, за кругом только
     кисть: руки расцепляются, рука поднимается и показывает на кнопку мессенджера, кисть выходит за край круга. Прозрачное видео (WebM VP9 / HEVC с альфой)
     проигрывается один раз, когда блок виден, и останавливается на жесте. Без анимации – сразу финальный кадр.
     Кадр 284×264: круг 240 px в левом верхнем углу, справа и снизу запас под кисть */
  .ava { flex: none; position: relative; width: 120px; height: 120px; --in: 112px; --b: 4px; }
  .ava::before { content: ""; position: absolute; inset: 0; border-radius: 50%; background: #ecebe8; border: var(--b) solid rgba(255, 255, 255, .7); }
  .ava__fig { position: absolute; left: var(--b); top: var(--b); width: calc(var(--in) * 283 / 240); height: calc(var(--in) * 278 / 240); max-width: none; object-fit: fill; }
  .ava__fig[hidden] { display: none; }
  :global([dir=rtl]) .ava__fig { scale: -1 1; transform-origin: calc(var(--in) / 2) 50%; }   /* справа налево кнопка слева – показывает влево */
  .who.go .who__msg a:first-child { animation: nudge .7s 1.7s ease-out both; }   /* кнопка отвечает, когда палец на неё указал */
  @keyframes nudge { 0% { box-shadow: 0 0 0 0 rgba(255,255,255,.75); } 100% { box-shadow: 0 0 0 14px rgba(255,255,255,0); } }
  @media (prefers-reduced-motion: reduce) { .who.go .who__msg a:first-child { animation: none; } }
  .who__txt b { display: block; font-size: 22px; line-height: 28px; }
  .who__txt span { font-size: 16px; opacity: .9; }
  .who__msg { display: flex; gap: 8px; }
  .who__msg a[hidden] { display: none; }
  .who__msg a { display: inline-flex; align-items: center; gap: 6px; height: 40px; padding: 0 14px; border-radius: 100px; background: var(--white); color: var(--gray-900); font-weight: 600; font-size: 14px; transition: transform .2s; }
  .who__msg a:hover { transform: translateY(-2px); }
  .line-ic { font-style: normal; font-size: 7px; font-weight: 800; color: var(--white); background: #06c755; border-radius: 6px; width: 20px; height: 20px; display: grid; place-items: center; }

  .cf { grid-area: form; position: relative; width: 100%; background: var(--white); border-radius: 25px; padding: 36px 32px 28px; display: flex; flex-direction: column; gap: 22px; box-shadow: 0 30px 60px rgba(120,30,0,.25); }
  .cf__f { position: relative; display: flex; align-items: center; gap: 10px; height: 54px; border: 1px solid var(--gray-300); border-radius: 12px; padding: 0 16px; }
  .cf__f:focus-within { border-color: var(--gray-900); }
  .cf__f > span { position: absolute; left: 12px; top: -9px; padding: 0 4px; background: var(--white); font-weight: 500; font-size: 13px; line-height: 16px; color: var(--gray-500); }
  .cf__f input, .cf__f select { flex: 1; min-width: 0; border: 0; outline: 0; background: none; font: 500 15px/22px "Manrope", sans-serif; color: var(--gray-900); }
  .cf__f input::placeholder { color: var(--gray-400); }
  .cf__ph select { flex: none; }
  .cf__ph i { width: 1px; height: 22px; background: var(--gray-300); }
  .cf__checks { display: flex; flex-direction: column; gap: 10px; font-weight: 500; font-size: 15px; line-height: 22px; color: #333; }
  .cf__checks label { display: flex; gap: 12px; align-items: flex-start; }
  .cf__checks input { width: 20px; height: 20px; margin-top: 1px; accent-color: var(--brand); flex: none; }
  .cf__checks a { color: var(--gray-900); text-decoration: underline; }
  .cf .btn--or { width: 100%; }
  .cf__err { color: var(--brand); font-size: 14px; }
  .cf__ok { position: absolute; inset: 0; border-radius: 25px; background: var(--white); display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; text-align: center; padding: 32px; animation: fade .4s; }
  .cf__ok[hidden] { display: none; }
  .cf__ok b { font-size: 28px; }
  .cf__ok span { color: var(--gray-600); }
  @keyframes fade { from { opacity: 0; } }

  @media (max-width: 1100px) {
    .ct__box { grid-template-columns: 1fr; grid-template-areas: "head" "form" "who"; padding: 48px 24px; row-gap: 28px; }
    .ct__head { align-self: auto; }
  }
  @media (max-width: 900px) {
    .ct { padding-block: 48px; }
    .ct__box { padding: 36px 16px 24px; border-radius: 24px; }
    .ct__head { gap: 12px; }
    .ct__head h2 { font-size: 36px; letter-spacing: -1px; }
    .ct__head p { font-size: 17px; line-height: 24px; }
    .ava { width: 88px; height: 88px; --in: 82px; --b: 3px; }
    .who__txt b { font-size: 19px; line-height: 24px; }
    .cf { padding: 28px 16px 20px; }
  }
</style>
