---
// Квиз «Tell us about your space» по Figma (набор 1766:1794, шаги Step=1…P7 и Final): две ветки по 7 шагов,
// у вариантов – 3D-иллюстрации из Figma. Площадь вводится в м² или sq ft, высота в м или ft (lib/units.ts);
// в заявку уходит в м² и м. Отправка – lib/lead.ts.
// CMO 22.11.2026: площадь и высота – кнопками в одно касание (площадь можно ввести точно), «24/7» одной формулировкой в обеих ветках,
// подвал или верхний этаж – уточнение про лифт, без счётчика шагов (CMO 23.11.2026), фиксированная высота, площадь из калькулятора – только если там вводили.
import Units from "./Units.astro";
type Opt = { v: string; img: string };
type Step = { k: string; q: string; hint?: string; area?: string; height?: string; opts?: Opt[] };
const I = (n: string) => `/assets/quiz/${n}.webp`;
const STEPS: Record<string, Step[]> = {
  space: [
    { k: "area", q: "Floor area", area: I("b-area") },
    { k: "height", q: "Ceiling height", hint: "From about 4.8 m we can add a second level", height: I("b-height") },
    { k: "climate", q: "Climate inside", opts: [{ v: "Heated", img: "climate-heated" }, { v: "Air-conditioned", img: "climate-ac" }, { v: "No climate control", img: "climate-none" }] },
    { k: "hours", q: "Can customers get in 24/7?", opts: [{ v: "Yes", img: "hours-247" }, { v: "No, limited hours", img: "hours-limited" }, { v: "Not sure", img: "hours-unknown" }] },
    { k: "parking", q: "Parking right at the entrance?", opts: [{ v: "With parking", img: "parking-yes" }, { v: "No parking", img: "parking-no" }, { v: "Not sure", img: "parking-unsure" }] },
    { k: "floor", q: "Which floor?", opts: [{ v: "Basement", img: "floor-basement" }, { v: "Ground floor", img: "floor-ground" }, { v: "Upper floor", img: "floor-upper" }] },
  ],
  land: [
    { k: "area", q: "Plot area", area: I("p-area") },
    { k: "surface", q: "Surface of the plot", opts: [{ v: "Concrete or asphalt", img: "surface-concrete" }, { v: "Gravel", img: "surface-gravel" }, { v: "Soil or grass", img: "surface-soil" }] },
    { k: "power", q: "Electricity on the plot?", opts: [{ v: "Yes", img: "power-yes" }, { v: "Can be connected", img: "power-connect" }, { v: "No", img: "power-no" }] },
    { k: "truck", q: "Can a truck drive onto the plot?", opts: [{ v: "Yes", img: "truck-yes" }, { v: "No", img: "truck-no" }, { v: "Not sure", img: "unsure" }] },
    { k: "hours", q: "Can customers get in 24/7?", opts: [{ v: "Yes", img: "hours-247" }, { v: "No, limited hours", img: "hours-limited" }, { v: "Not sure", img: "hours-unknown" }] },
    { k: "parking", q: "Room to park next to the containers?", opts: [{ v: "Yes", img: "parking-yes" }, { v: "No", img: "parking-no" }, { v: "Not sure", img: "parking-unsure" }] },
  ],
};
---
<section class="qz" id="check" data-quiz>
  <div class="qz__in wrap">
    <div class="qz__head">
      <h2>Tell us about your space</h2>
      <p>7 quick questions, about a minute.<br />We get in touch with a free assessment</p>
    </div>
    <div class="qz__body">

      <div class="step is-on" data-step="1">
        <h3>What do you have?</h3>
        <div class="cards">
          <button type="button" class="pick" data-branch="space">
            <i class="radio"></i>
            <img src="/assets/figma/quiz-building.webp" width="340" height="340" alt="" loading="lazy" />
            <b>A space in a building</b><span>Warehouse, retail, basement, office</span>
          </button>
          <button type="button" class="pick" data-branch="land">
            <i class="radio"></i>
            <img src="/assets/figma/quiz-plot.webp" width="340" height="340" alt="" loading="lazy" />
            <b>A plot of land</b><span>We place storage containers</span>
          </button>
        </div>
      </div>

      {Object.entries(STEPS).map(([br, list]) => list.map((s, i) => (
        <div class="step" data-step={i + 2} data-br={br} data-k={s.k}>
          <h3>{s.q}</h3>
          {s.area && (
            <div class="num">
              <img src={s.area} width="330" height="240" alt="" loading="lazy" />
              <div class="num__u"><Units /></div>
              <div class="chips" data-area-chips>
                {[[0, 100], [100, 300], [300, 1000], [1000, 0]].map(([a, b]) => <button type="button" class="chip" data-a={a} data-b={b}></button>)}
              </div>
              <button type="button" class="num__exact" data-exact-btn>Enter exact area</button>
              <label class="num__f" data-exact hidden><span>Floor area</span><input inputmode="numeric" autocomplete="off" placeholder="250" data-area /><em data-au>m²</em></label>
              <p class="num__from" data-from hidden>From your calculation</p>
            </div>
          )}
          {s.height && (
            <div class="num">
              <img src={s.height} width="330" height="240" alt="" loading="lazy" />
              <div class="chips" data-height-chips>
                {["lt3", "3to48", "ge48", "unsure"].map((v) => <button type="button" class="chip" data-h={v}></button>)}
              </div>
              <p class="num__hint" data-hint>{s.hint}</p>
            </div>
          )}
          {s.opts && (
            <div class="opts">{s.opts.map((o) => (
              <button type="button" class="opt" data-v={o.v}>
                <img src={I(o.img)} width="80" height="80" alt="" loading="lazy" /><b>{o.v}</b><i class="radio"></i>
              </button>
            ))}</div>
          )}
          {s.k === "floor" && (
            <div class="lift" data-lift hidden>
              <b>Is there a lift or a hoist?</b>
              <div class="chips chips--2"><button type="button" class="chip" data-lift-v="Yes">Yes</button><button type="button" class="chip" data-lift-v="No">No</button></div>
            </div>
          )}
        </div>
      )))}

      <form class="step fin" data-step="8" novalidate>
        <h3>Get your free assessment</h3>
        <p class="fin__lead">We'll get in touch within 1 working hour, ask a few questions and estimate what your space can earn</p>
        <label class="in"><span>Name</span><input name="name" autocomplete="name" placeholder="Your name" /></label>
        <label class="in"><span>City of the space</span><input name="city" autocomplete="address-level2" placeholder="e.g. Bangkok" /></label>
        <div class="in in--ph"><span>Phone number</span>
          <select name="code" aria-label="Country code"></select><i></i>
          <input name="phone" type="tel" autocomplete="tel-national" placeholder="81 234 5678" />
        </div>
        <label class="chk"><input type="checkbox" name="agree" /> <span>I agree to the processing of my data under the <a href="https://spacehubstore.com/thailand/en/privacy" target="_blank" rel="noopener">privacy policy</a></span></label>
        <div class="fin__btns">
          <button type="button" class="btn btn--light" data-back2><img src="/assets/figma/arrow-left.svg" width="20" height="20" alt="" />Back</button>
          <button class="btn btn--or" type="submit">Send</button>
        </div>
      </form>

      <div class="step done" data-step="9">
        <img src="/assets/alexey.webp" width="96" height="96" alt="" />
        <h3>Thank you</h3>
        <p>Alexey, Head of partnerships, will contact you within 1 working hour</p>
      </div>

      <div class="nav" data-nav>
        <button type="button" class="btn btn--sm btn--light" data-back><img src="/assets/figma/arrow-left.svg" width="20" height="20" alt="" />Back</button>
        <button type="button" class="btn btn--sm btn--dark" data-next>Next<img src="/assets/figma/arrow-right-w.svg" width="20" height="20" alt="" /></button>
      </div>
    </div>
  </div>
</section>

<script>
  import { sendLead } from "../lib/lead";
  import { prepare, ready } from "../lib/formsLazy";
  import { onUnit, getUnit, SQFT } from "../lib/units";
  const root = document.querySelector<HTMLElement>("[data-quiz]")!;
  const $ = <T extends Element>(s: string) => root.querySelector<T>(s)!;
  const $$ = <T extends Element>(s: string) => Array.from(root.querySelectorAll<T>(s));
  const st = { step: 1, branch: "", ans: {} as Record<string, string>, area_m2: 0, started: false, seen: new Set<number>() };
  const dl = (o: object) => (window as any).dataLayer?.push(o);
  const cur = () => (st.step === 1 || st.step >= 8 ? $<HTMLElement>(`[data-step="${st.step}"]`) : $<HTMLElement>(`[data-step="${st.step}"][data-br="${st.branch}"]`));
  const show = (dir = 1) => {
    $$<HTMLElement>("[data-step]").forEach((e) => e.classList.remove("is-on", "from-left"));
    const c = cur(); c.classList.add("is-on"); if (dir < 0) c.classList.add("from-left");

    $<HTMLElement>("[data-nav]").hidden = st.step >= 8 || st.step === 1;
    nav();
  };
  const ok = () => {
    if (st.step === 1) return !!st.branch;
    if (st.step >= 8) return true;
    const k = cur().dataset.k!;
    if (k === "area") return st.area_m2 > 0 || !!st.ans.area;
    if (k === "floor" && /Basement|Upper/.test(st.ans.floor || "")) return !!st.ans.lift;
    return !!st.ans[k];
  };
  // аналитика: номер шага, вопрос и ответ – видно, на каком шаге и после какого ответа уходят
  // Next только там, где без неё не уйти (CMO 23.11.2026): точная площадь введена вручную или шаг уже был пройден и к нему вернулись;
  // на шагах с выбором квиз сам переходит дальше по клику
  const nav = () => {
    const k = cur().dataset.k;
    const exact = k === "area" && !cur().querySelector<HTMLElement>("[data-exact]")?.hidden && st.area_m2 > 0;
    const b = $<HTMLButtonElement>("[data-next]");
    b.hidden = !(ok() && (exact || st.seen.has(st.step)));
  };
  const next = () => {
    if (!ok()) return;
    const k = st.step === 1 ? "branch" : cur().dataset.k!;
    dl({ event: "quiz_step", step: st.step, branch: st.branch, question: k,
         answer: k === "branch" ? st.branch : k === "area" ? (st.ans.area || `${Math.round(st.area_m2)} m²`) : st.ans[k] + (k === "floor" && st.ans.lift ? `, lift: ${st.ans.lift}` : "") });
    st.seen.add(st.step); st.step++; show(); if (st.step === 8) ready(form).then((m) => m.refillForm(form));
  };
  const back = () => { if (st.step > 1) { st.step--; show(-1); } };

  $$<HTMLButtonElement>("[data-branch]").forEach((b) => b.addEventListener("click", () => {
    if (!st.started) { st.started = true; dl({ event: "quiz_started", branch: b.dataset.branch }); }
    st.branch = b.dataset.branch!; $$("[data-branch]").forEach((x) => x.classList.toggle("on", x === b)); prefill(); setTimeout(next, 220); }));
  $$<HTMLButtonElement>(".opt").forEach((b) => b.addEventListener("click", () => {
    const s = b.closest<HTMLElement>("[data-k]")!; st.ans[s.dataset.k!] = b.dataset.v!;
    s.querySelectorAll(".opt").forEach((x) => x.classList.toggle("on", x === b));
    // подвал или верхний этаж – сначала уточнение про лифт
    const lift = s.querySelector<HTMLElement>("[data-lift]");
    if (lift) { const need = /Basement|Upper/.test(b.dataset.v!); lift.hidden = !need; if (!need) delete st.ans.lift; else { nav(); return; } }
    setTimeout(next, 260); }));
  $$<HTMLButtonElement>("[data-lift-v]").forEach((b) => b.addEventListener("click", () => {
    st.ans.lift = b.dataset.liftV!; b.parentElement!.querySelectorAll(".chip").forEach((x) => x.classList.toggle("on", x === b)); setTimeout(next, 260); }));
  // площадь: кнопки диапазонов в выбранных единицах или точное число; в заявку – м²
  const AREA_FT: Record<string, string> = { "0-100": "Under 1,000 sq ft", "100-300": "1,000–3,000 sq ft", "300-1000": "3,000–10,000 sq ft", "1000-0": "10,000+ sq ft" };
  const AREA_M2: Record<string, string> = { "0-100": "Under 100 m²", "100-300": "100–300 m²", "300-1000": "300–1,000 m²", "1000-0": "1,000+ m²" };
  const HEIGHT: Record<string, [string, string]> = { lt3: ["Under 3 m", "Under 10 ft"], "3to48": ["3–4.8 m", "10–16 ft"], ge48: ["4.8 m or more", "16 ft or more"], unsure: ["Not sure", "Not sure"] };
  const areas = $$<HTMLInputElement>("[data-area]");
  const label = () => { const u = getUnit();
    $$<HTMLButtonElement>("[data-a]").forEach((c) => (c.textContent = (u === "ft" ? AREA_FT : AREA_M2)[`${c.dataset.a}-${c.dataset.b}`]));
    $$<HTMLButtonElement>("[data-h]").forEach((c) => (c.textContent = HEIGHT[c.dataset.h!][u === "ft" ? 1 : 0]));
    $$("[data-au]").forEach((e) => (e.textContent = u === "ft" ? "sq ft" : "m²"));
    $$("[data-hint]").forEach((e) => (e.textContent = `From about ${u === "ft" ? "16 ft" : "4.8 m"} we can add a second level`));
    areas.forEach((a) => (a.value = st.area_m2 ? Math.round(st.area_m2 * (u === "ft" ? SQFT : 1)).toLocaleString("en-US") : ""));
  };
  $$<HTMLButtonElement>("[data-a]").forEach((c) => c.addEventListener("click", () => {
    st.ans.area = AREA_M2[`${c.dataset.a}-${c.dataset.b}`]; st.area_m2 = 0;
    $$("[data-a]").forEach((x) => x.classList.toggle("on", x.dataset.a === c.dataset.a)); setTimeout(next, 220); }));
  $$<HTMLButtonElement>("[data-exact-btn]").forEach((b) => b.addEventListener("click", () => {
    const f = b.nextElementSibling as HTMLElement; f.hidden = false; b.hidden = true; f.querySelector("input")!.focus(); }));
  areas.forEach((a) => a.addEventListener("input", () => {
    const n = Math.min(+a.value.replace(/[^\d]/g, "") || 0, 100000 * (getUnit() === "ft" ? SQFT : 1));
    a.value = n ? n.toLocaleString("en-US") : "";
    st.area_m2 = n / (getUnit() === "ft" ? SQFT : 1); delete st.ans.area;
    hl(st.area_m2);
    nav(); }));
  // точное число подсвечивает свой диапазон
  const hl = (m2: number) => $$<HTMLElement>("[data-a]").forEach((x) => x.classList.toggle("on", m2 > 0 && m2 >= +x.dataset.a! && (!+x.dataset.b! || m2 < +x.dataset.b!)));
  areas.forEach((i) => i.addEventListener("keydown", (e) => e.key === "Enter" && (e.preventDefault(), next())));
  $$<HTMLButtonElement>("[data-h]").forEach((c) => c.addEventListener("click", () => {
    st.ans.height = HEIGHT[c.dataset.h!][0]; $$("[data-h]").forEach((x) => x.classList.toggle("on", x === c)); setTimeout(next, 220); }));
  onUnit(label);

  // площадь и высота из калькулятора – только если там действительно вводили данные (sh_calc, Calculator.astro)
  function prefill() {
    let c: { area_m2?: number; levels?: number } = {};
    try { c = JSON.parse(sessionStorage.getItem("sh_calc") || "{}"); } catch { /* нет */ }
    if (st.branch !== "space" || !c.area_m2 || st.area_m2 || st.ans.area) return;
    st.area_m2 = c.area_m2;
    const step = $<HTMLElement>('[data-step="2"][data-br="space"]');
    (step.querySelector("[data-exact]") as HTMLElement).hidden = false; (step.querySelector("[data-exact-btn]") as HTMLElement).hidden = true;
    (step.querySelector("[data-from]") as HTMLElement).hidden = false;
    hl(st.area_m2);
    if (c.levels === 2 && !st.ans.height) { st.ans.height = HEIGHT.ge48[0]; $$('[data-h="ge48"]').forEach((x) => x.classList.add("on")); }
    label();
  }
  $("[data-next]").addEventListener("click", next);
  $("[data-back]").addEventListener("click", back);
  $("[data-back2]").addEventListener("click", back);

  const form = $<HTMLFormElement>("form.fin");
  prepare(form);
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const { ok, phone } = (await ready(form)).checkForm(form, "quiz");
    if (!ok) return;
    const ans = { ...st.ans, ...(st.area_m2 ? { area_m2: Math.round(st.area_m2) } : {}) };
    const txt = `Franchise request: ${st.branch === "land" ? "plot of land" : "space in a building"}, ${Object.entries(ans).map(([k, v]) => `${k}: ${v}`).join(", ")}. ` +
                `${f.get("name")}, ${phone}, ${f.get("city") || ""}`;
    const how = await sendLead({ form: "quiz", branch: st.branch, answers: ans, area_unit_shown: getUnit(),
                                 name: f.get("name"), phone, city: f.get("city") }, txt);
    dl({ event: "franchise_callback_form_sent", form_location: "quiz", branch: st.branch, site_variant: location.pathname, delivery: how });
    st.step = 9; show();
  });
  show();
</script>

<style>
  .qz { position: relative; overflow: hidden; padding-block: 64px; }
  .qz__in { position: relative; display: flex; flex-direction: column; align-items: center; gap: 48px; }
  .qz__head { max-width: 768px; text-align: center; display: flex; flex-direction: column; gap: 20px; }
  .qz__head h2 { font-weight: 700; font-size: 48px; line-height: 54px; }
  .qz__head p { font-weight: 500; font-size: 20px; line-height: 28px; }
  /* фиксированная высота: шаги разной высоты не двигают страницу, кнопки навигации внизу */
  .qz__body { width: 100%; max-width: 820px; display: flex; flex-direction: column; align-items: center; gap: 28px; min-height: 640px; }


  .step { display: none; flex-direction: column; align-items: center; gap: 24px; width: 100%; }
  .step.is-on { display: flex; animation: slide .35s ease-out; }
  .step.from-left { animation-name: slideL; }
  @keyframes slide { from { opacity: 0; transform: translateX(24px); } }
  @keyframes slideL { from { opacity: 0; transform: translateX(-24px); } }
  .step h3 { font-weight: 700; font-size: 26px; line-height: 30px; text-align: center; }

  .cards { display: flex; gap: 24px; justify-content: center; width: 100%; }
  .pick { position: relative; width: 377px; border: 1px solid var(--gray-300); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 8px; text-align: left; color: #333; background: var(--white); transition: border-color .2s, transform .2s, box-shadow .2s; }
  .pick:hover { transform: translateY(-3px); box-shadow: 0 14px 30px rgba(0,0,0,.06); }
  .pick img { width: 100%; height: 229px; object-fit: contain; margin-top: 10px; transform: scale(1.15); }
  .pick b { font-weight: 700; font-size: 18px; line-height: 26px; }
  .pick span { font-weight: 500; font-size: 16px; line-height: 24px; }
  .radio { width: 20px; height: 20px; flex: none; background: url(/assets/figma/radio-off.svg) center/contain no-repeat; }
  .pick .radio { position: absolute; top: 24px; right: 24px; z-index: 1; }
  .pick.on, .opt.on { border-color: var(--brand); }
  .pick.on .radio, .opt.on .radio { background-image: url(/assets/figma/radio-on.svg); }

  .opts { display: flex; flex-direction: column; gap: 12px; width: 100%; max-width: 470px; }
  .opt { display: flex; align-items: center; gap: 16px; padding: 8px 20px 8px 8px; border: 1px solid var(--gray-300); border-radius: 16px; background: var(--white); text-align: left; transition: border-color .2s, transform .2s; }
  .opt:hover { transform: translateX(4px); }
  .opt img { width: 72px; height: 72px; object-fit: contain; transition: transform .3s cubic-bezier(.2,1.4,.4,1); }
  .opt.on img { transform: scale(1.12) rotate(-4deg); }
  .opt b { flex: 1; font-weight: 600; font-size: 16px; }

  .num { display: flex; flex-direction: column; align-items: center; gap: 20px; width: 100%; max-width: 420px; }
  .num img { width: 330px; height: auto; }
  .num__f { position: relative; display: flex; align-items: center; gap: 12px; width: 100%; height: 56px; padding: 0 8px 0 16px; border: 1px solid var(--gray-300); border-radius: 12px; background: var(--white); }
  .num__f:focus-within { border-color: var(--gray-900); }
  .num__f > span { position: absolute; left: 12px; top: -9px; padding: 0 4px; background: var(--white); font-weight: 500; font-size: 13px; line-height: 16px; color: var(--gray-500); }
  .num__f input { flex: 1; min-width: 0; border: 0; outline: 0; font: 600 18px "Manrope", sans-serif; background: none; }
  .num__f em { font-style: normal; font-weight: 600; color: var(--gray-500); padding-right: 8px; }
  .num__hint { color: var(--gray-500); font-size: 14px; }
  .num__u { margin-top: -8px; }
  .chips { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%; }
  .chip { height: 48px; border: 1px solid var(--gray-300); border-radius: 12px; background: var(--white); font-weight: 600; font-size: 15px; transition: border-color .2s, color .2s; }
  .chip:hover { border-color: var(--gray-500); }
  .chip.on { border-color: var(--brand); color: var(--brand); }
  .num__exact { font-weight: 600; font-size: 14px; color: var(--gray-600); text-decoration: underline; text-underline-offset: 3px; }
  .num__f[hidden], .num__exact[hidden] { display: none; }
  .num__from { margin-top: -10px; font-size: 13px; color: var(--brand); }
  .lift { display: flex; flex-direction: column; align-items: center; gap: 10px; width: 100%; max-width: 470px; animation: slide .3s ease-out; }
  .lift[hidden] { display: none; }
  .lift b { font-size: 16px; }

  .fin { max-width: 470px; background: var(--white); border-radius: 24px; padding: 32px; box-shadow: 0 24px 60px rgba(24,24,27,.08); gap: 18px; align-items: stretch; }
  .fin__lead { text-align: center; color: var(--gray-600); font-size: 15px; line-height: 22px; margin-top: -6px; }
  .in { position: relative; display: flex; align-items: center; gap: 10px; height: 52px; border: 1px solid var(--gray-300); border-radius: 12px; padding: 0 14px; }
  .in:focus-within { border-color: var(--gray-900); }
  .in > span { position: absolute; left: 10px; top: -9px; padding: 0 4px; background: var(--white); font-weight: 500; font-size: 13px; color: var(--gray-500); }
  .in input, .in select { flex: 1; min-width: 0; border: 0; outline: 0; background: none; font: 500 15px "Manrope", sans-serif; color: var(--gray-900); }
