---
// Блок «What the franchise includes» (Figma 1316:9773): Technology, Marketing, Operations, Equipment.
// Микроанимации (CMO 22.11.2026): одно действие на карточку, до 1 с, отдельные движения 200–450 мс (NN/g: 100–500 мс).
// Десктоп – при наведении, откат 250 мс; без наведения (телефон) – один раз, когда карточка в экране; reduce motion – без анимаций.
---
<section class="inc wrap">
  <div class="inc__head">
    <h2>What the franchise includes</h2>
    <p>Four teams work on your facility from day one.<br />Live from our network today</p>
  </div>
  <div class="inc__grid">
    <article class="ic ic--tech" data-mi>
      <div class="ic__phone"><img src="/assets/figma/inc-phone.webp" width="300" height="612" alt="SpaceHub customer app" loading="lazy" /><div class="slide" aria-hidden="true"><span class="slide__t slide__t--a">Open</span><span class="slide__t slide__t--b">Unlocked</span><i class="knob"><svg viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"/><path class="shackle" d="M8 11V8a4 4 0 0 1 8 0v3"/></svg></i></div></div>
      <div class="ic__txt">
        <h3>Technology</h3>
        <p>Customer app for booking, payment and Bluetooth access. Owner dashboard updated daily</p>
      </div>
    </article>
    <div class="inc__mid">
      <article class="ic ic--mkt" data-mi>
        <div class="ic__txt">
          <h3>Marketing</h3>
          <p>Search and maps listings, Google Ads, social campaigns and a landing page for your facility</p>
        </div>
        <span class="logo logo--g"><img src="/assets/figma/inc-google.svg" width="50" height="50" alt="Google" /></span>
        <span class="logo logo--m"><img src="/assets/figma/inc-meta.svg" width="60" height="60" alt="Meta" /></span>
        <span class="logo logo--p"><img src="/assets/figma/inc-maps.png" width="43" height="55" alt="Google Maps" /></span>
        <span class="logo logo--t"><img src="/assets/figma/inc-tiktok.svg" width="49" height="54" alt="TikTok" /></span>
      </article>
      <article class="ic ic--ops" data-mi>
        <img class="ic__chat" src="/assets/figma/inc-chat.webp" width="118" height="118" alt="" loading="lazy" />
        <span class="ic__reply" aria-hidden="true">Booked for you ✓</span>
        <div class="ic__txt">
          <h3>Operations</h3>
          <p>Call centre and chat in your language, pricing, contracts, payments and debt collection</p>
        </div>
      </article>
    </div>
    <article class="ic ic--eq" data-mi>
      <div class="ic__txt">
        <h3>Equipment</h3>
        <p>One partner for the whole fit-out. We design the layout and the unit mix, calculate the cost of the equipment, produce it, deliver it and install it</p>
      </div>
      <div class="ic__eq"><img class="eq-a" src="/assets/figma/inc-eq-a.webp" width="1032" height="741" alt="Workers installing storage units" loading="lazy" /><img class="eq-b" src="/assets/figma/inc-eq-b.webp" width="1032" height="741" alt="" aria-hidden="true" loading="lazy" /><i class="spark" aria-hidden="true"></i></div>
    </article>
  </div>
</section>

<script>
  // микроанимация карточки: класс .play – при наведении; без наведения – один раз, когда карточка в экране
  const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-mi]"));
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) {
    if (matchMedia("(hover: hover)").matches) {
      cards.forEach((c) => {
        c.addEventListener("mouseenter", () => c.classList.add("play"));
        c.addEventListener("mouseleave", () => c.classList.remove("play"));
      });
    } else {
      const io = new IntersectionObserver((es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add("play"); io.unobserve(e.target); } }), { threshold: .6 });
      cards.forEach((c) => io.observe(c));
    }
  }
</script>

<style>
  .inc { padding-block: 96px; display: flex; flex-direction: column; align-items: center; gap: 64px; }
  .inc__head { max-width: 768px; text-align: center; display: flex; flex-direction: column; gap: 20px; }
  .inc__head h2 { font-weight: 700; font-size: 48px; line-height: 54px; }
  .inc__head p { font-weight: 500; font-size: 20px; line-height: 28px; }
  .inc__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; width: 100%; max-width: 1296px; height: 565px; }
  .inc__mid { display: grid; grid-template-rows: 276px 1fr; gap: 12px; min-width: 0; }
  .ic { position: relative; overflow: hidden; background: var(--gray-100); border-radius: 25px; padding: 32px; display: flex; flex-direction: column; min-width: 0; }
  .ic__txt { position: relative; display: flex; flex-direction: column; gap: 8px; }
  .ic h3 { font-weight: 700; font-size: 26px; line-height: 30px; }
  .ic p { font-weight: 500; font-size: 16px; line-height: 24px; letter-spacing: 0.16px; }
  .ic--tech { justify-content: flex-end; }
  .ic__phone { position: absolute; left: 50%; top: -235px; width: 300px; transform: translateX(-50%); }
  .ic__phone img { width: 100%; display: block; }
  /* ползунок «Open» поверх нарисованного (Figma inc-phone: дорожка x 52–549, y 977–1088 из 600×1225) */
  .slide { position: absolute; left: 8.67%; top: 79.76%; width: 82.8%; height: 9.06%; border-radius: 999px; background: #f5f5f5; container-type: inline-size; overflow: hidden; }
  .slide__t { position: absolute; inset: 0; display: grid; place-items: center; font-weight: 500; font-size: 7.4cqw; color: #18181b; transition: opacity .2s; }
  .slide__t--b { opacity: 0; color: var(--brand); font-weight: 700; }
  .knob { position: absolute; left: 2%; top: 9%; height: 82%; aspect-ratio: 1; border-radius: 50%; background: var(--brand); display: grid; place-items: center;
          box-shadow: 0 4px 10px rgba(255,79,0,.35); transition: left .25s ease-in; }
  .knob svg { width: 42%; fill: none; stroke: #fff; stroke-width: 2.2; stroke-linecap: round; }
  .knob .shackle { transform-origin: 16px 11px; transition: transform .15s; }
  .play .knob { left: 79.7%; transition: left .45s cubic-bezier(.5,0,.3,1); }
  .play .knob .shackle { transform: translateY(-2.5px) rotate(18deg); transition-delay: .45s; }
  .play .slide__t--a { opacity: 0; }
  .play .slide__t--b { opacity: 1; transition-delay: .4s; }
  /* Marketing: иконки по очереди подпрыгивают, 300 мс с шагом 60 мс */
  .play .logo { animation: hop .3s cubic-bezier(.3,1.6,.5,1) both; }
  .play .logo--m { animation-delay: .06s; } .play .logo--p { animation-delay: .12s; } .play .logo--t { animation-delay: .18s; }
  @keyframes hop { 50% { translate: 0 -12px; } }
  /* Operations: пузырь пружинит, рядом короткий ответ */
  .ic__reply { position: absolute; left: 32px; top: 40px; background: var(--white); border-radius: 14px 14px 14px 4px; padding: 8px 14px; font-weight: 600; font-size: 14px;
               box-shadow: 0 8px 20px rgba(0,0,0,.08); opacity: 0; translate: 0 6px; transition: opacity .2s, translate .2s; }
  .play .ic__reply { opacity: 1; translate: 0 0; transition: opacity .25s .25s, translate .3s .25s cubic-bezier(.3,1.5,.5,1); }
  .play .ic__chat { animation: boing .3s cubic-bezier(.3,1.6,.5,1); }
  @keyframes boing { 50% { scale: 1.08; } }
  .logo { position: absolute; width: 86px; height: 86px; border-radius: 24px; background: rgba(255,255,255,.2); box-shadow: 4px 4px 4px rgba(0,0,0,.05);
          display: flex; align-items: center; justify-content: center; backdrop-filter: blur(4px); }
  .logo--g { left: -18px; top: 155px; transform: rotate(-23deg); }
  .logo--m { left: 108px; top: 132px; transform: rotate(-5deg); }
  .logo--p { left: 229px; top: 167px; transform: rotate(5deg); }
  .logo--t { left: 353px; top: 126px; transform: rotate(13deg); }
  .ic--ops { justify-content: flex-end; align-items: flex-end; }
  .ic--ops .ic__txt { width: 100%; }
  .ic__chat { width: 118px; margin: auto 0 8px; }
  /* Equipment: установка (генерация по иллюстрации Figma, 22.11.2026). Наведение: 3 вспышки сварки ~350 мс, затем за 250 мс
     кадр «дверь установлена»; точка сварки – 42,6 % × 46 % кадра (landing-icons/gen_install.py) */
  .ic__eq { position: absolute; left: 24px; top: 190px; width: 540px; max-width: none; }
  .ic__eq img { display: block; width: 100%; height: auto; mix-blend-mode: multiply; }
  .eq-b { position: absolute; inset: 0; opacity: 0; transition: opacity .25s; }
  .play .eq-b { opacity: 1; transition: opacity .25s .35s; }
  .spark { position: absolute; left: 42.6%; top: 46%; width: 34px; height: 34px; margin: -17px 0 0 -17px; border-radius: 50%; opacity: 0; pointer-events: none;
           background: radial-gradient(circle, #fff 0 18%, #ffd28a 30%, rgba(255,120,30,.7) 50%, rgba(255,79,0,0) 72%); }
  .play .spark { animation: weld .35s steps(1, end); }
  @keyframes weld { 0% { opacity: 1; transform: scale(1); } 33% { opacity: .2; transform: scale(.6); } 50% { opacity: 1; transform: scale(1.15); } 83% { opacity: 0; } }
  @media (max-width: 900px) {
    .inc { padding-block: 64px; gap: 32px; }
    .inc__head h2 { font-size: 32px; line-height: 38px; }
    .inc__head p { font-size: 17px; line-height: 24px; }
    .inc__grid { grid-template-columns: 1fr; height: auto; }
    .inc__mid { grid-template-rows: 300px auto; }
    .ic { padding: 24px; }
    .ic h3 { font-size: 22px; line-height: 26px; }
    .ic--tech { height: 520px; }
    .ic__phone { top: -250px; width: 280px; }
    .logo--g { left: 0; top: 190px; } .logo--m { left: 90px; top: 175px; } .logo--p { left: 180px; top: 200px; } .logo--t { left: 270px; top: 170px; }
    .ic--eq { height: 460px; }
    .ic__eq { left: 8px; top: 190px; width: 440px; }
  }
</style>
