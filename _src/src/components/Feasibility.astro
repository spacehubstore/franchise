---
// Блок «What the feasibility study includes» (Figma 1913:1363), переработан (CMO 22.11.2026):
// слева два этапа – бесплатная оценка и платное исследование (цена – в FAQ), справа четыре документа исследования.
// Иллюстрации – Nano Banana Pro в стиле One floor, по реальным фото оснащения (landing-icons/gen_study*.py: market-4, layout-8,
// budget-1; layout-9 и budget-0 – кадры для анимации). Надписи поверх – кодом, позиции в % от кадра 4:3. Планировка – цифры модели Шарджи (185 м² пола → 301 м² в аренду, F-1783).
// Финмодель – схема без сумм: стройка, рост заполнения, выход на целевую загрузку, 4–5× к текущей аренде (как на первом экране).
// Анимация – одна карточка за раз: играет, когда карточка доходит до середины экрана, и останавливается в конечном виде.
const stages = [
  { t: "Free assessment", w: "48 hours", d: "Send the address and a few photos. We tell you if the space fits" },
  { t: "Feasibility study", w: "2 weeks", d: "If it fits, we prepare four documents for your address", note: "Paid step, only after the assessment" },
];
// пины конкурентов: x, y (% кадра, кончик пина) и цена за м² – условные, для образца
const pins = [[14, 47, "$38/m²"], [81, 44, "$44/m²"], [56, 17, "$52/m²"], [47, 78, "$41/m²"]];
const kit = ["Doors and frames", "Partitions", "Ladders", "Access and locks", "CCTV", "Delivery and installation"];
// размерные линии планировки (координаты кадра 1200×896, вдоль контура помещения, снаружи): растут из середины к концам
type P = [number, number];
const dims: { a: P; b: P; to: number; d: number }[] = [
  { a: [85, 538], b: [610, 883], to: 14.8, d: 0 },
  { a: [666, 882], b: [1076, 587], to: 12.5, d: 150 },
];
const dimG = dims.map(({ a, b, to, d }) => {
  const [dx, dy] = [b[0] - a[0], b[1] - a[1]], L = Math.hypot(dx, dy), u: P = [dx / L, dy / L], n: P = [-u[1], u[0]];
  const m: P = [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];
  const head = (t: P, s: number) => `M${t[0] - s * 22 * u[0] + 9 * n[0]},${t[1] - s * 22 * u[1] + 9 * n[1]}L${t[0]},${t[1]}L${t[0] - s * 22 * u[0] - 9 * n[0]},${t[1] - s * 22 * u[1] - 9 * n[1]}`;
  const tick = (t: P) => `M${t[0] - 16 * n[0]},${t[1] - 16 * n[1]}L${t[0] + 16 * n[0]},${t[1] + 16 * n[1]}`;
  return { to, d, m, ang: (Math.atan2(dy, dx) * 180) / Math.PI, half1: `M${m[0]},${m[1]}L${a[0]},${a[1]}`, half2: `M${m[0]},${m[1]}L${b[0]},${b[1]}`,
           heads: head(a, -1) + head(b, 1), ticks: tick(a) + tick(b) };
});
// схема дохода за первые 3 года: отделка (0–4 мес), заполнение (до 22 мес), полная загрузка; текущая аренда = 1/4.5 итогового дохода
const W = 520, H = 150, M = 36, X = (m: number) => +(m * (W / M)).toFixed(1), Y = (k: number) => +(H - k * (H - 16)).toFixed(1);
const k = (m: number) => (m < 4 ? 0 : 1 - (1 - Math.min(1, (m - 4) / 18)) ** 2);
const line = "M" + Array.from({ length: M * 4 + 1 }, (_, i) => `${X(i / 4)},${Y(k(i / 4))}`).join("L");
const area = `${line}L${W},${H}L0,${H}Z`;
const RENT = Y(1 / 4.5), TOP = Y(1);
const phases: [string, number, number][] = [["Fit-out", 0, 4], ["Filling up", 4, 22], ["Full", 22, 36]];
---
<section class="fs-wrap wrap" id="study">
  <div class="fs">
    <div class="fs__left">
      <div class="fs__head">
        <h2>What the feasibility study includes</h2>
        <p>Start with a free assessment. If your space fits, the study shows what to build, at what price and what it earns</p>
      </div>
      <ol class="fs__stages">
        {stages.map((s, i) => (
          <li class={i === 1 ? "on" : ""}>
            <b><span>0{i + 1}.</span>{s.t}<em>{s.w}</em></b>
            <p>{s.d}</p>
            {s.note && <small>{s.note}</small>}
          </li>
        ))}
      </ol>
      <button type="button" class="btn btn--or fs__cta" data-open-study data-ev="study_cta" data-loc="feasibility">Start with a free assessment</button>
    </div>

    <div class="fs__cards">
      <div class="fc" data-play data-card="market">
        <div class="fc__t"><h3>Market and competitors</h3><p>Competitors near you, their prices and the unit sizes the area is missing. We price every unit to win that demand</p></div>
        <div class="fc__img">
          <img src="/assets/study/market.webp" width="960" height="717" alt="" loading="lazy" />
          <span class="mk mk--me" style="left:51%;top:40%;--d:0ms">You</span>
          {pins.map(([x, y, p], i) => <span class="mk" style={`left:${x}%;top:${y}%;--d:${180 + i * 140}ms`}>{p}</span>)}
        </div>
      </div>

      <div class="fc" data-play data-card="layout">
        <div class="fc__t">
          <h3>Unit layout</h3>
          <p>The mix of unit sizes that earns the most from your floor, based on our rental data. A second level where the ceiling allows</p>
          <div class="fc__stat"><b data-to="185" data-suf=" m²" data-d="900">185 m²</b><i>→</i><b class="o" data-to="301" data-suf=" m²" data-d="1100">301 m²</b><span>floor</span><span></span><span>to rent</span></div>
        </div>
        <div class="fc__img">
          <img src="/assets/study/layout.webp" width="960" height="717" alt="" loading="lazy" />
          <svg class="dims" viewBox="0 0 1200 896" aria-hidden="true">
            {dimG.map((g) => (
              <g style={`--d:${g.d}ms`}>
                <path d={g.ticks} class="dims__tick" />
                <path d={g.half1} class="dims__ln" pathLength="1" /><path d={g.half2} class="dims__ln" pathLength="1" />
                <path d={g.heads} class="dims__head" />
                <g transform={`translate(${g.m[0]} ${g.m[1]}) rotate(${g.ang})`} class="dims__v">
                  <rect x="-84" y="-34" width="168" height="58" rx="10" />
                  <text y="12" text-anchor="middle" data-to={g.to} data-dec="1" data-suf=" m" data-d={g.d + 250}>{g.to} m</text>
                </g>
              </g>
            ))}
          </svg>
        </div>
      </div>

      <div class="fc" data-play data-card="budget">
        <div class="fc__t">
          <h3>Equipment budget</h3><p>Every item your layout needs, with delivery and installation, in one total price</p>
          <ul class="kit">{kit.map((t, i) => <li style={`--d:${i * 90}ms`}>{t}</li>)}</ul>
        </div>
        <div class="fc__img">
          <img src="/assets/study/budget.webp" width="960" height="717" alt="" loading="lazy" data-final />
          <video class="fc__vid" muted playsinline preload="none" poster="/assets/study/budget-0.webp" data-drop data-src="/assets/study/budget.mp4" hidden></video>
        </div>
      </div>

      <div class="fc fc--model" data-play data-card="model">
        <div class="fc__t">
          <span class="fc__tag">The result of the study</span>
          <h3>Financial model</h3>
          <p>Occupancy, revenue, costs and your net income, month by month for 10 years, and what the property is worth. The calculator above, built for your address</p>
        </div>
        <svg class="fm" viewBox={`-4 -10 ${W + 8} ${H + 44}`} aria-hidden="true">
          <path d={area} class="fm__area" />
          <path d={`M0 ${RENT}H${W}`} class="fm__rent" />
          <path d={line} class="fm__line" pathLength="1" />
          <text x={W} y={RENT + 20} class="fm__lab" text-anchor="end">Today's rent</text>
          <text x={W} y={TOP - 10} class="fm__lab fm__note" style="--d:0ms" text-anchor="end">With SpaceHub</text>
          <g class="fm__note" style="--d:200ms">
            <path d={`M${X(29)} ${RENT - 4}V${TOP + 5}`} class="fm__span" />
            <text x={X(29) - 12} y={(RENT + TOP) / 2 + 11} class="fm__big" text-anchor="end">4–5×</text>
          </g>
          <path d={`M0 ${H}H${W}`} class="fm__base" />
          {phases.map(([t, a, b], i) => (
            <g><path d={`M${X(b)} ${H}V${H + 10}`} class="fm__sep" style={i === 2 ? "display:none" : ""} /><text x={(X(a) + X(b)) / 2} y={H + 26} class="fm__ax" text-anchor="middle">{t}</text></g>
          ))}
        </svg>
        <ul class="fm__chips">{["Occupancy", "Revenue", "Costs", "Net income", "Property value"].map((t) => <li>{t}</li>)}</ul>
      </div>
    </div>
  </div>
</section>

<script>
  import { openLead } from "../lib/leadModal";
  const root = document.querySelector<HTMLElement>("#study")!;
  root.querySelector("[data-open-study]")!.addEventListener("click", () => openLead({
    form: "feasibility", title: "Free assessment of your space", lead: "We get in touch within 1 working hour and tell you if the space fits. The study comes after, only if it does",
    text: (who) => `Franchise request: free assessment (feasibility block). ${who}`,
  }));
  // анимация по одной карточке: срабатывает в средней полосе экрана, играет один раз
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
  // досчёт чисел: размеры после того, как выросли линии, площади – следом
  const count = (el: HTMLElement) => {
    const to = +el.dataset.to!, dec = +(el.dataset.dec || 0), suf = el.dataset.suf || "", d = +(el.dataset.d || 0);
    const f = (n: number) => n.toFixed(dec) + suf;
    el.textContent = f(0);
    setTimeout(() => { const t0 = performance.now(); const tick = (t: number) => { const q = Math.min(1, (t - t0) / 700);
      el.textContent = f(to * (1 - (1 - q) ** 3)); if (q < 1) requestAnimationFrame(tick); }; requestAnimationFrame(tick); }, d);
  };
  // бюджет: детали падают на паллет (ролик), останавливается на последнем кадре = итоговой картинке
  const vid = root.querySelector<HTMLVideoElement>("[data-drop]");
  const img = root.querySelector<HTMLImageElement>("[data-final]");
  if (vid && img && !still) {
    // пока карточка не доиграла – пустой паллет; ролик грузится заранее, когда блок близко
    vid.hidden = false; img.style.visibility = "hidden";
    new IntersectionObserver((es, o) => { if (es[0].isIntersecting) { vid.src = vid.dataset.src!; vid.preload = "auto"; o.disconnect(); } }, { rootMargin: "600px 0px" }).observe(vid);
    vid.addEventListener("ended", () => { img.style.visibility = ""; vid.hidden = true; });
  }
  function drop(v: HTMLVideoElement) { if (!v.src) v.src = v.dataset.src!; v.playbackRate = 1.6; v.play().catch(() => { img!.style.visibility = ""; v.hidden = true; }); }
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    if (!e.isIntersecting) return;
    const c = e.target as HTMLElement; c.classList.add("play"); io.unobserve(c);
    c.querySelectorAll<HTMLElement | SVGElement>("[data-to]").forEach((el) => count(el as HTMLElement));
    const v = c.querySelector<HTMLVideoElement>("[data-drop]"); if (v) drop(v);
    (window as any).dataLayer?.push({ event: "study_card_viewed", card: c.dataset.card });
  }), { rootMargin: "-40% 0px -40% 0px" });
  root.querySelectorAll("[data-play]").forEach((c) => (still ? c.classList.add("play") : io.observe(c)));
</script>

<style>
  .fs-wrap { padding-block: 24px 96px; }
  .fs { background: var(--gray-900); color: var(--white); border-radius: 32px; padding: 72px; display: flex; gap: 64px; max-width: 1296px; margin: 0 auto; }
  .fs__left { flex: none; width: 420px; display: flex; flex-direction: column; gap: 36px; position: sticky; top: calc(var(--hdr-h) + 32px); align-self: flex-start; }
  .fs__head { display: flex; flex-direction: column; gap: 20px; }
  .fs__head h2 { font-weight: 700; font-size: 48px; line-height: 54px; }
  .fs__head p { font-weight: 500; font-size: 20px; line-height: 28px; color: var(--gray-300); }
  .fs__stages { list-style: none; display: flex; flex-direction: column; gap: 24px; }
  .fs__stages b { display: flex; align-items: baseline; gap: 16px; font-weight: 700; font-size: 26px; line-height: 30px; }
  .fs__stages b span { width: 44px; flex: none; }
  .fs__stages em { margin-left: auto; font-style: normal; font-weight: 600; font-size: 14px; line-height: 20px; padding: 4px 12px; border-radius: 99px; border: 1px solid var(--gray-600); color: var(--gray-300); white-space: nowrap; }
  .fs__stages p { padding-left: 60px; margin-top: 10px; font-weight: 500; font-size: 18px; line-height: 26px; color: var(--gray-300); }
  .fs__stages small { display: block; padding-left: 60px; margin-top: 6px; font-size: 14px; color: var(--gray-500); }
  .fs__stages .on b { color: var(--brand); }
  .fs__stages .on em { border-color: var(--brand); color: var(--brand); }
  .fs__cta { align-self: flex-start; }

  .fs__cards { flex: 1; min-width: 0; display: grid; gap: 8px; }
  .fc { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.35fr); gap: 20px; align-items: center; border-radius: 24px; padding: 20px 20px 20px 28px; background: var(--white); color: var(--gray-900); }
  .fc__t { display: flex; flex-direction: column; gap: 12px; }
  .fc h3 { font-weight: 700; font-size: 24px; line-height: 28px; letter-spacing: -0.48px; }
  .fc p { font-weight: 500; font-size: 15px; line-height: 22px; color: var(--gray-700); }
  .fc__img { position: relative; aspect-ratio: 960 / 717; border-radius: 16px; overflow: hidden; background: var(--white); }
  .fc__img img { width: 100%; height: 100%; display: block; }
  .fc__stat { display: grid; grid-template-columns: auto auto auto; justify-content: start; column-gap: 10px; align-items: baseline; margin-top: 4px; }
  .fc__stat b { font-weight: 800; font-size: 26px; line-height: 30px; font-variant-numeric: tabular-nums; }
  .fc__stat b.o { color: var(--brand); }
  .fc__stat i { font-style: normal; font-size: 20px; color: var(--gray-500); }
  .fc__stat span { font-size: 13px; font-weight: 600; color: var(--gray-500); }

  /* надписи поверх иллюстраций */
  .mk { position: absolute; white-space: nowrap; font-weight: 700; font-size: 12px; line-height: 16px; }
  .mk { transform: translate(-50%, -100%); padding: 5px 9px; border-radius: 99px; background: var(--gray-900); color: var(--white); box-shadow: 0 6px 14px rgba(0,0,0,.18); }
  .mk::after { content: ""; position: absolute; left: 50%; top: 100%; margin-left: -5px; border: 5px solid transparent; border-top-color: var(--gray-900); }
  .mk--me { background: var(--brand); padding: 6px 12px; }
  .mk--me::after { border-top-color: var(--brand); }
  .dim { transform: translate(-50%, -50%) rotate(var(--r)); padding: 1px 6px; background: var(--white); color: var(--gray-700); font-weight: 700; font-size: 12px; }
  .fc__vid { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; background: var(--white); }
  .dims { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .dims__ln { fill: none; stroke: var(--gray-900); stroke-width: 3.5; stroke-dasharray: 1; stroke-dashoffset: 0; }
  .dims__tick { fill: none; stroke: var(--gray-700); stroke-width: 3; }
  .dims__head { fill: none; stroke: var(--gray-900); stroke-width: 3.5; stroke-linecap: round; stroke-linejoin: round; }
  .dims__v rect { fill: var(--white); }
  .dims__v text { font: 800 46px "Manrope", sans-serif; fill: var(--gray-900); font-variant-numeric: tabular-nums; }
  .kit { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; }
  .kit li { padding: 3px 9px; border-radius: 99px; background: var(--gray-100); font-size: 12px; font-weight: 700; color: var(--gray-700); }

  /* финансовая модель – итог, выделена */
  .fc--model { grid-template-columns: 1fr; gap: 20px; padding: 32px 28px 26px; background: var(--brand); color: var(--white); box-shadow: 0 24px 60px rgba(255, 79, 0, .28); }
  .fc--model .fc__t { max-width: 540px; }
  .fc--model h3 { font-size: 30px; line-height: 34px; }
  .fc--model p { font-size: 16px; line-height: 24px; color: rgba(255, 255, 255, .88); }
  .fc__tag { align-self: flex-start; padding: 4px 12px; border-radius: 99px; background: rgba(255, 255, 255, .18); font-weight: 700; font-size: 12px; letter-spacing: .06em; text-transform: uppercase; }
  .fm { width: 100%; height: auto; overflow: visible; }
  .fm text { font-family: "Manrope", sans-serif; }
  .fm__base { stroke: rgba(255, 255, 255, .4); stroke-width: 1; }
  .fm__area { fill: rgba(255, 255, 255, .16); }
  .fm__rent { stroke: rgba(255, 255, 255, .75); stroke-width: 1.5; stroke-dasharray: 5 5; }
  .fm__line { fill: none; stroke: var(--white); stroke-width: 3; stroke-linejoin: round; stroke-linecap: round; }
  .fm__span { stroke: var(--white); stroke-width: 2; }
  .fm__sep { stroke: rgba(255, 255, 255, .5); stroke-width: 1; }
  .fm__lab { fill: var(--white); font-size: 14px; font-weight: 700; }
  .fm__big { fill: var(--white); font-size: 34px; font-weight: 800; }
  .fm__ax { fill: rgba(255, 255, 255, .8); font-size: 13px; font-weight: 600; }
  .fm__chips { display: flex; flex-wrap: wrap; gap: 6px; list-style: none; }
  .fm__chips li { padding: 4px 10px; border-radius: 99px; border: 1px solid rgba(255, 255, 255, .45); font-size: 12px; font-weight: 700; }

  /* анимация: начальное состояние только до .play; без JS всё видно */
  .fc[data-play]:not(.play) .mk { opacity: 0; transform: translate(-50%, -160%) scale(.6); }
  .mk { transition: transform .45s cubic-bezier(.2, 1.5, .4, 1) var(--d), opacity .2s var(--d); }
  .fc[data-play]:not(.play) .dims__ln { stroke-dashoffset: 1; }
  .dims__ln { transition: stroke-dashoffset .5s cubic-bezier(.4, 0, .2, 1) var(--d); }
  .fc[data-play]:not(.play) .dims__head, .fc[data-play]:not(.play) .dims__tick, .fc[data-play]:not(.play) .dims__v { opacity: 0; }
  .dims__head, .dims__tick { transition: opacity .2s calc(var(--d) + .45s); }
  .dims__v { transition: opacity .25s calc(var(--d) + .2s); }
  .fc[data-play]:not(.play) .kit li { opacity: 0; transform: translateY(4px); }
  .kit li { transition: opacity .25s var(--d), transform .25s ease-out var(--d); }
  .fc[data-play]:not(.play) .fm__line { stroke-dashoffset: 1; }
  .fm__line { stroke-dasharray: 1; stroke-dashoffset: 0; transition: stroke-dashoffset 1.1s cubic-bezier(.4, 0, .2, 1) .1s; }
  .fc[data-play]:not(.play) .fm__area, .fc[data-play]:not(.play) .fm__note { opacity: 0; }
  .fm__area { transition: opacity .5s .8s; }
  .fm__note { transition: opacity .35s calc(var(--d) + .2s); }
  @media (prefers-reduced-motion: reduce) { .mk, .dims__ln, .dims__head, .dims__tick, .dims__v, .kit li, .fm__line, .fm__area, .fm__note { transition: none; } }

  @media (max-width: 1100px) {
    .fs { flex-direction: column; padding: 40px 20px; gap: 32px; border-radius: 24px; }
    .fs__left { width: 100%; position: static; }
  }
  @media (max-width: 900px) {
    .fs-wrap { padding-block: 8px 64px; }
    .fs__head h2 { font-size: 32px; line-height: 38px; }
    .fs__head p, .fs__stages p { font-size: 17px; line-height: 24px; }
    .fs__stages b { font-size: 22px; gap: 10px; flex-wrap: wrap; }
    .fs__stages b span { width: 36px; }
    .fs__stages em { margin-left: 0; }
    .fs__stages p, .fs__stages small { padding-left: 46px; }
    .fs__cta { align-self: stretch; }
    .fc { grid-template-columns: 1fr; gap: 14px; padding: 20px 14px 14px; }
    .fc__t { padding-inline: 6px; }
    .fc--model { padding: 24px 18px 20px; }
    .fc--model h3 { font-size: 26px; line-height: 30px; }
    .fm__lab { font-size: 22px; } .fm__big { font-size: 44px; } .fm__ax { font-size: 20px; }
  }
</style>
